<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RegNeps.Mobile.OfflineCapturePage"
             Title="Captura offline"
             BackgroundColor="#F4F5F2">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">

            <!-- Conectividad / sesión -->
            <Label x:Name="StatusBanner"
                   FontSize="14"
                   TextColor="#7C2D12"
                   BackgroundColor="#FFEDD5"
                   Padding="10"
                   Text="Comprobando estado…" />

            <Label x:Name="SessionLabel" FontSize="13" TextColor="#444" />

            <!-- Resumen Outbox -->
            <Border Stroke="#D1D5DB" StrokeThickness="1" Padding="12" BackgroundColor="White">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Resumen de sincronización" FontAttributes="Bold" FontSize="15" />
                    <Label x:Name="CounterPendingLabel" FontSize="13" Text="Pendientes: 0" />
                    <Label x:Name="CounterSyncedLabel" FontSize="13" Text="Sincronizadas: 0" />
                    <Label x:Name="CounterErrorLabel" FontSize="13" Text="Con error: 0" />
                    <Label x:Name="CounterConflictLabel" FontSize="13" Text="En conflicto: 0" />
                    <Label x:Name="LastSyncLabel" FontSize="12" TextColor="#6B7280" Text="Última sincronización: —" />
                    <Label x:Name="SyncStateLabel" FontSize="12" TextColor="#6B7280" Text="" />
                </VerticalStackLayout>
            </Border>

            <Button x:Name="SyncNowButton"
                    Text="Sincronizar ahora"
                    Clicked="OnSyncClicked"
                    BackgroundColor="#1E3A5F"
                    TextColor="White" />

            <Button x:Name="ReloginButton"
                    Text="Volver a iniciar sesión"
                    Clicked="OnReloginClicked"
                    IsVisible="False"
                    BackgroundColor="#92400E"
                    TextColor="White" />

            <Label x:Name="MessageLabel" FontSize="13" />

            <!-- Captura Create-only -->
            <Label Text="Nuevo registro" FontAttributes="Bold" FontSize="16" Margin="0,8,0,0" />

            <Label Text="Telar *" FontAttributes="Bold" />
            <Entry x:Name="TelarEntry" Placeholder="Ej. 003" />

            <Label Text="Neps (Q) *" FontAttributes="Bold" />
            <Entry x:Name="NepsEntry" Placeholder="Ej. 18" Keyboard="Numeric" TextChanged="OnNepsChanged" />

            <Label x:Name="QualityLabel"
                   FontSize="16"
                   FontAttributes="Bold"
                   Text="Calidad: —" />

            <Label x:Name="CatalogStatusLabel"
                   FontSize="12"
                   TextColor="#6B7280"
                   Text="Catálogos: comprobando…" />

            <Label Text="Tela" />
            <Picker x:Name="TelaPicker"
                    Title="Seleccionar tela (catálogo local)"
                    SelectedIndexChanged="OnTelaPickerChanged" />
            <Entry x:Name="TelaEntry" Placeholder="Tela (texto libre si no hay catálogo)" />

            <Label Text="Lote/trama" />
            <Picker x:Name="LotePicker"
                    Title="Seleccionar lote (catálogo local)"
                    SelectedIndexChanged="OnLotePickerChanged" />
            <Entry x:Name="LoteEntry" Placeholder="Lote (texto libre si no hay catálogo)" />

            <Label Text="Turno" />
            <Entry x:Name="TurnoEntry" Placeholder="A / B / C" />

            <Label Text="Operario" />
            <Entry x:Name="OperarioEntry" />

            <Label Text="Observación" />
            <Editor x:Name="ObservacionEditor" AutoSize="TextChanges" HeightRequest="80" />

            <Button Text="Guardar offline"
                    Clicked="OnSaveClicked"
                    BackgroundColor="#294D1E"
                    TextColor="White" />

            <Button Text="Operaciones offline"
                    Clicked="OnOperationsClicked"
                    BackgroundColor="#374151"
                    TextColor="White" />

            <!-- Conflictos -->
            <Label Text="Conflictos (requieren revisión)"
                   FontAttributes="Bold"
                   Margin="0,12,0,0"
                   FontSize="15" />
            <Label x:Name="ConflictsEmptyLabel"
                   FontSize="12"
                   TextColor="#6B7280"
                   Text="No hay conflictos pendientes." />
            <CollectionView x:Name="ConflictsList" HeightRequest="160">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Stroke="#F59E0B" StrokeThickness="1" Padding="10" Margin="0,0,0,8" BackgroundColor="#FFFBEB">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="{Binding EntityLabel}" FontAttributes="Bold" />
                                <Label Text="{Binding OperationTypeLabel}" FontSize="12" TextColor="#92400E" />
                                <Label Text="{Binding LocalSummary}" FontSize="12" />
                                <Label Text="{Binding ServerSummary}" FontSize="12" TextColor="#1E3A5F" />
                                <Label Text="{Binding Reason}" FontSize="12" TextColor="#7C2D12" />
                                <Label Text="{Binding ActionHint}" FontAttributes="Bold" FontSize="12" TextColor="#B45309" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Errores SyncError -->
            <Label Text="Errores de sincronización"
                   FontAttributes="Bold"
                   Margin="0,8,0,0"
                   FontSize="15" />
            <Label x:Name="ErrorsEmptyLabel"
                   FontSize="12"
                   TextColor="#6B7280"
                   Text="No hay errores permanentes." />
            <CollectionView x:Name="ErrorsList" HeightRequest="120">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Stroke="#DC2626" StrokeThickness="1" Padding="10" Margin="0,0,0,8" BackgroundColor="#FEF2F2">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="{Binding Title}" FontAttributes="Bold" FontSize="13" />
                                <Label Text="{Binding Detail}" FontSize="12" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label Text="Editables / eliminables (sincronizados)" FontAttributes="Bold" Margin="0,12,0,0" FontSize="15" />
            <Label x:Name="EditableEmptyLabel"
                   FontSize="12"
                   TextColor="#6B7280"
                   Text="No hay registros mutables. Sincroniza un Create primero." />
            <CollectionView x:Name="EditableList"
                            HeightRequest="140"
                            SelectionMode="Single"
                            SelectionChanged="OnEditableSelectionChanged">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Stroke="#D1D5DB" Padding="10" Margin="0,0,0,6" BackgroundColor="White">
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label Text="{Binding Title}" FontAttributes="Bold" FontSize="13" />
                                    <Label Text="{Binding Subtitle}" FontSize="11" TextColor="#6B7280" />
                                </VerticalStackLayout>
                                <Label Grid.Column="1"
                                       Text="{Binding ActionHint}"
                                       VerticalOptions="Center"
                                       TextColor="#1E3A5F"
                                       FontAttributes="Bold"
                                       FontSize="12" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label Text="Recientes" FontAttributes="Bold" Margin="0,12,0,0" />
            <CollectionView x:Name="RecentList" HeightRequest="200">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="6" ColumnDefinitions="*,Auto,Auto">
                            <Label Grid.Column="0" Text="{Binding Telar}" />
                            <Label Grid.Column="1" Text="{Binding NepsText}" Margin="8,0" />
                            <Label Grid.Column="2" Text="{Binding Quality}" TextColor="#B45309" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Button Text="Cerrar sesión local"
                    Clicked="OnLogoutClicked"
                    BackgroundColor="Transparent"
                    TextColor="#7C2D12" />

            <Label FontSize="11"
                   TextColor="#6B7280"
                   Text="Cerrar sesión no elimina el trabajo offline pendiente." />

            <Button Text="Volver"
                    Clicked="OnBackClicked"
                    BackgroundColor="Transparent"
                    TextColor="#294D1E" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
