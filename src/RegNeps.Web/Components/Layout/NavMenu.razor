@inject CurrentUserService CurrentUser
@inject NavigationManager Nav
@implements IDisposable

<input type="checkbox" id="nav-mobile-toggle" class="mobile-toggle-input" />

<aside class="app-sidebar @(_collapsed ? "is-collapsed" : null)" aria-label="Navegación principal">
    <div class="sidebar-brand">
        <a href="/dashboard" class="brand-link">
            <span class="brand-mark" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                     stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 3v18h18" />
                    <path d="M18 17V9" />
                    <path d="M13 17V5" />
                    <path d="M8 17v-3" />
                </svg>
            </span>
            <span class="brand-text">
                <span class="brand-title">RegNeps</span>
                <span class="brand-sub">VICUNHA</span>
            </span>
        </a>
    </div>

    <nav class="sidebar-nav">
        <ul class="sidebar-list">
            @foreach (var link in _links)
            {
                @if (!link.Submenu)
                {
                    <li class="sidebar-item">
                        <NavLink class="sidebar-link" href="@link.Href" Match="NavLinkMatch.All">
                            <span class="nav-icon" aria-hidden="true">@MarkupIcon(link.Icon)</span>
                            <span class="nav-label">@link.Label</span>
                        </NavLink>
                    </li>
                }
                else
                {
                    <li class="sidebar-section" aria-labelledby="@($"nav-sec-{link.Key}")">
                        <div class="sidebar-section-label" id="@($"nav-sec-{link.Key}")">@link.Label</div>
                        <ul class="sidebar-section-list">
                            @foreach (var item in link.Items)
                            {
                                <li>
                                    <NavLink class="sidebar-link" href="@item.Href">
                                        <span class="nav-icon" aria-hidden="true">@MarkupIcon(item.Icon)</span>
                                        <span class="nav-label">@item.Label</span>
                                    </NavLink>
                                </li>
                            }
                        </ul>
                    </li>
                }
            }
        </ul>
    </nav>

    <div class="sidebar-footer">
        @if (_session is not null)
        {
            <div class="sidebar-user" title="@_session.DisplayName">
                <span class="sidebar-user-avatar" aria-hidden="true">@Initials(_session.DisplayName)</span>
                <span class="sidebar-user-meta">
                    <span class="sidebar-user-name">@_session.DisplayName</span>
                    <form method="post" action="/api/logout" class="d-inline">
                        <button type="submit" class="sidebar-logout btn btn-link p-0 align-baseline">Cerrar sesión</button>
                    </form>
                </span>
                <button type="button"
                        class="sidebar-collapse-btn"
                        title="@(_collapsed ? "Expandir menú" : "Contraer menú")"
                        aria-label="@(_collapsed ? "Expandir menú" : "Contraer menú")"
                        aria-pressed="@_collapsed"
                        @onclick="ToggleCollapsed">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                         aria-hidden="true">
                        <path d="M15 18l-6-6 6-6" />
                    </svg>
                </button>
            </div>
        }
    </div>
</aside>

<header class="app-topbar">
    <div class="topbar-inner">
        <div class="topbar-left">
            <label for="nav-mobile-toggle" class="mobile-toggle" aria-label="Abrir o cerrar menú">
                <svg class="hamburger" width="18" height="18" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                     aria-hidden="true">
                    <path d="M4 12L20 12" class="line line-top" />
                    <path d="M4 12H20" class="line line-mid" />
                    <path d="M4 12H20" class="line line-bot" />
                </svg>
            </label>
            <nav class="topbar-crumbs" aria-label="Ruta">
                <span class="topbar-crumb-root">Panel de calidad</span>
                <span class="topbar-crumb-sep" aria-hidden="true">/</span>
                <span class="topbar-crumb-current">@CurrentSection</span>
            </nav>
        </div>

        <div class="topbar-right">
            <NotificationCenter />
            @if (_session is not null)
            {
                <span class="user-chip" title="@_session.DisplayName">
                    <span class="user-avatar" aria-hidden="true">@Initials(_session.DisplayName)</span>
                    <span class="user-name">@_session.DisplayName</span>
                </span>
                <form method="post" action="/api/logout" class="d-inline">
                    <button type="submit" class="btn-ghost">Salir</button>
                </form>
            }
        </div>
    </div>
</header>

<label for="nav-mobile-toggle" class="mobile-backdrop" aria-hidden="true"></label>

@code {
    private UserSession? _session;
    private List<NavLinkDef> _links = [];
    private bool _collapsed;

    private string CurrentSection
    {
        get
        {
            var path = Nav.ToBaseRelativePath(Nav.Uri).Trim('/').Split('?', '#')[0].ToLowerInvariant();
            return path switch
            {
                "" or "dashboard" => "Dashboard",
                "captura" => "Captura",
                "registros" => "Registros",
                "alertas" => "Alertas",
                "graficas" => "Gráficas",
                "telas" => "Telas",
                "lotes" => "Lotes",
                "informes" => "Informes",
                "reportes" => "Reportes",
                "exportar" => "Exportar",
                "usuarios" => "Usuarios",
                "migracion" => "Migración",
                "config" => "Configuración",
                _ => "RegNeps"
            };
        }
    }

    protected override async Task OnInitializedAsync()
    {
        Nav.LocationChanged += OnLocationChanged;
        _session = await CurrentUser.GetAsync();
        _links = BuildLinks();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) =>
        InvokeAsync(StateHasChanged);

    private void ToggleCollapsed() => _collapsed = !_collapsed;

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;

    private List<NavLinkDef> BuildLinks()
    {
        var links = new List<NavLinkDef>();

        if (_session?.Has(AppPermission.ViewDashboard) == true)
            links.Add(new NavLinkDef("home", "Resumen", "/dashboard", "home"));

        var operacion = new List<NavItemDef>();
        if (_session?.Has(AppPermission.CaptureRecords) == true)
            operacion.Add(new("captura", "Captura", "camera"));
        if (_session?.Has(AppPermission.ViewRecords) == true)
            operacion.Add(new("registros", "Registros", "list"));
        if (_session?.Has(AppPermission.ViewAlerts) == true)
            operacion.Add(new("alertas", "Alertas", "alert"));
        if (_session?.Has(AppPermission.ViewDashboard) == true)
            operacion.Add(new("graficas", "Gráficas", "chart"));
        if (_session?.Has(AppPermission.ManageFabrics) == true)
        {
            operacion.Add(new("telas", "Telas", "fabric"));
            operacion.Add(new("lotes", "Lotes de trama", "lote"));
        }
        if (operacion.Count > 0)
            links.Add(new NavLinkDef("operacion", "Operación", operacion));

        var reportes = new List<NavItemDef>();
        if (_session?.Has(AppPermission.ManageReports) == true)
            reportes.Add(new("informes", "Informes guardados", "bookmark"));
        if (_session?.Has(AppPermission.ExportReports) == true)
        {
            reportes.Add(new("reportes", "Reportes profesionales", "report"));
            reportes.Add(new("exportar", "Exportar", "export"));
        }
        if (reportes.Count > 0)
            links.Add(new NavLinkDef("reportes", "Reportes", reportes));

        var admin = new List<NavItemDef>();
        if (_session?.Has(AppPermission.ManageUsers) == true)
        {
            admin.Add(new("usuarios", "Usuarios", "users"));
            admin.Add(new("migracion", "Migración histórica", "database"));
        }
        if (_session?.Has(AppPermission.ViewSettings) == true)
            admin.Add(new("config", "Configuración", "gear"));
        if (admin.Count > 0)
            links.Add(new NavLinkDef("admin", "Administración", admin));

        return links;
    }

    private static string Initials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1) return parts[0][..Math.Min(2, parts[0].Length)].ToUpperInvariant();
        return $"{parts[0][0]}{parts[^1][0]}".ToUpperInvariant();
    }

    private static MarkupString MarkupIcon(string? icon) => icon switch
    {
        "home" => new("""<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>"""),
        "camera" => new("""<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3l-2.5-3z"/><circle cx="12" cy="13" r="3"/></svg>"""),
        "list" => new("""<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M8 6h13"/><path d="M8 12h13"/><path d="M8 18h13"/><path d="M3 6h.01"/><path d="M3 12h.01"/><path d="M3 18h.01"/></svg>"""),
        "alert" => new("""<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3"/><path d="M12 9v4"/><path d="M12 17h.01"/></svg>"""),
        "chart" => new("""<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="m19 9-5 5-4-4-3 3"/></svg>"""),
        "fabric" => new("""<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M3 9h18"/><path d="M3 15h18"/><path d="M9 3v18"/><path d="M15 3v18"/></svg>"""),
        "lote" => new("""<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="m12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83Z"/><path d="m22 17.65-9.17 4.16a2 2 0 0 1-1.66 0L2 17.65"/><path d="m22 12.65-9.17 4.16a2 2 0 0 1-1.66 0L2 12.65"/></svg>"""),
        "bookmark" => new("""<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"/></svg>"""),
        "report" => new("""<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><path d="M8 13h2"/><path d="M8 17h8"/><path d="M14 13v4"/></svg>"""),
        "export" => new("""<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" x2="12" y1="3" y2="15"/></svg>"""),
        "users" => new("""<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>"""),
        "database" => new("""<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/><path d="M3 12c0 1.66 4 3 9 3s9-1.34 9-3"/></svg>"""),
        "gear" => new("""<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M12 1v2M12 21v2M4.2 4.2l1.4 1.4M18.4 18.4l1.4 1.4M1 12h2M21 12h2M4.2 19.8l1.4-1.4M18.4 5.6l1.4-1.4"/></svg>"""),
        _ => new("")
    };

    private sealed record NavItemDef(string Href, string Label, string Icon);

    private sealed class NavLinkDef
    {
        public string Key { get; }
        public string Label { get; }
        public string? Href { get; }
        public string? Icon { get; }
        public bool Submenu { get; }
        public IReadOnlyList<NavItemDef> Items { get; }

        public NavLinkDef(string key, string label, string href, string icon)
        {
            Key = key;
            Label = label;
            Href = href;
            Icon = icon;
            Submenu = false;
            Items = [];
        }

        public NavLinkDef(string key, string label, IReadOnlyList<NavItemDef> items)
        {
            Key = key;
            Label = label;
            Href = null;
            Icon = null;
            Submenu = true;
            Items = items;
        }
    }
}
