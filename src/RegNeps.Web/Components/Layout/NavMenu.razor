@inject CurrentUserService CurrentUser

<header class="app-header">
    <div class="app-header-inner">
        <div class="app-header-left">
            <input type="checkbox" id="nav-mobile-toggle" class="mobile-toggle-input" />
            <label for="nav-mobile-toggle" class="mobile-toggle" aria-label="Abrir o cerrar menú">
                <svg class="hamburger" width="16" height="16" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                     aria-hidden="true">
                    <path d="M4 12L20 12" class="line line-top" />
                    <path d="M4 12H20" class="line line-mid" />
                    <path d="M4 12H20" class="line line-bot" />
                </svg>
            </label>

            <div class="brand-nav">
                <a href="/dashboard" class="brand-link">RegNeps VICUNHA</a>

                <nav class="desktop-nav" aria-label="Principal">
                    <ul class="nav-list">
                        @foreach (var link in _links)
                        {
                            <li class="nav-item @(link.Submenu ? "has-submenu" : null)">
                                @if (!link.Submenu)
                                {
                                    <NavLink class="nav-trigger" href="@link.Href" Match="NavLinkMatch.All">
                                        @link.Label
                                    </NavLink>
                                }
                                else
                                {
                                    <details class="submenu-details">
                                        <summary class="nav-trigger submenu-trigger">
                                            @link.Label
                                            <svg class="chevron" width="12" height="12" viewBox="0 0 24 24" fill="none"
                                                 stroke="currentColor" stroke-width="2" aria-hidden="true">
                                                <path d="M6 9l6 6 6-6" />
                                            </svg>
                                        </summary>
                                        <div class="submenu-panel submenu-@link.Type" role="menu">
                                            <ul class="submenu-grid">
                                                @foreach (var item in link.Items)
                                                {
                                                    var linkClass = link.Type == "icon" ? "submenu-link is-icon" : "submenu-link";
                                                    <li>
                                                        <NavLink class="@linkClass" href="@item.Href">
                                                            @if (link.Type == "icon" && !string.IsNullOrEmpty(item.Icon))
                                                            {
                                                                <span class="item-icon" aria-hidden="true">@MarkupIcon(item.Icon)</span>
                                                                <span class="submenu-label">@item.Label</span>
                                                            }
                                                            else if (link.Type == "description")
                                                            {
                                                                <span class="submenu-label">@item.Label</span>
                                                                <span class="submenu-desc">@item.Description</span>
                                                            }
                                                            else
                                                            {
                                                                <span class="submenu-label">@item.Label</span>
                                                            }
                                                        </NavLink>
                                                    </li>
                                                }
                                            </ul>
                                        </div>
                                    </details>
                                }
                            </li>
                        }
                    </ul>
                </nav>
            </div>
        </div>

        <div class="app-header-right">
            @if (_session is not null)
            {
                <span class="user-name" title="@_session.DisplayName">@_session.DisplayName</span>
                <a class="btn-ghost" href="/api/logout">Cerrar sesión</a>
            }
        </div>
    </div>

    <label for="nav-mobile-toggle" class="mobile-backdrop" aria-hidden="true"></label>
    <div class="mobile-panel" role="dialog" aria-label="Menú de navegación">
        <nav>
            @for (var i = 0; i < _links.Count; i++)
            {
                var link = _links[i];
                <div class="mobile-group">
                    @if (!link.Submenu)
                    {
                        <NavLink class="mobile-link" href="@link.Href" Match="NavLinkMatch.All">
                            @link.Label
                        </NavLink>
                    }
                    else
                    {
                        <div class="mobile-group-label">@link.Label</div>
                        <ul class="mobile-sublist">
                            @foreach (var item in link.Items)
                            {
                                <li>
                                    <NavLink class="mobile-link" href="@item.Href">
                                        @item.Label
                                    </NavLink>
                                </li>
                            }
                        </ul>
                    }
                </div>
                @if (i < _links.Count - 1 && ShouldSeparate(_links[i], _links[i + 1]))
                {
                    <div class="mobile-separator" role="separator"></div>
                }
            }
        </nav>
    </div>
</header>

@code {
    private UserSession? _session;
    private List<NavLinkDef> _links = [];

    protected override async Task OnInitializedAsync()
    {
        _session = await CurrentUser.GetAsync();
        _links = BuildLinks();
    }

    private List<NavLinkDef> BuildLinks()
    {
        var links = new List<NavLinkDef>();

        if (_session?.Has(AppPermission.ViewDashboard) == true)
            links.Add(new NavLinkDef("home", "Inicio", "/dashboard"));

        var operacion = new List<NavItemDef>();
        if (_session?.Has(AppPermission.CaptureRecords) == true)
            operacion.Add(new("captura", "Captura", "Registrar neps en planta."));
        if (_session?.Has(AppPermission.ViewRecords) == true)
            operacion.Add(new("registros", "Registros", "Consultar, filtrar e importar históricos."));
        if (_session?.Has(AppPermission.ViewAlerts) == true)
            operacion.Add(new("alertas", "Alertas", "Umbrales, reincidencias y correctivas."));
        if (_session?.Has(AppPermission.ViewDashboard) == true)
            operacion.Add(new("graficas", "Gráficas", "KPIs y tendencias de calidad."));
        if (_session?.Has(AppPermission.ManageFabrics) == true)
        {
            operacion.Add(new("telas", "Telas", "Catálogo de telas y referencias."));
            operacion.Add(new("lotes", "Lotes de trama", "Catálogo de lotes usados en captura."));
        }
        if (operacion.Count > 0)
            links.Add(new NavLinkDef("operacion", "Operación", operacion, "description"));

        var reportes = new List<NavItemDef>();
        if (_session?.Has(AppPermission.ManageReports) == true)
            reportes.Add(new("informes", "Informes guardados"));
        if (_session?.Has(AppPermission.ExportReports) == true)
        {
            reportes.Add(new("reportes", "Reportes profesionales"));
            reportes.Add(new("exportar", "Exportar"));
        }
        if (reportes.Count > 0)
            links.Add(new NavLinkDef("reportes", "Reportes", reportes, "simple"));

        var admin = new List<NavItemDef>();
        if (_session?.Has(AppPermission.ManageUsers) == true)
        {
            admin.Add(new("usuarios", "Usuarios", Icon: "users"));
            admin.Add(new("migracion", "Migración histórica", Icon: "cloud"));
        }
        if (_session?.Has(AppPermission.ViewSettings) == true)
            admin.Add(new("config", "Configuración", Icon: "gear"));
        if (admin.Count > 0)
            links.Add(new NavLinkDef("admin", "Administración", admin, "icon"));

        return links;
    }

    private static bool ShouldSeparate(NavLinkDef current, NavLinkDef next) =>
        current.Submenu != next.Submenu
        || (current.Submenu && next.Submenu && current.Type != next.Type);

    private static MarkupString MarkupIcon(string icon) => icon switch
    {
        "users" => new(
            """<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>"""),
        "cloud" => new(
            """<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 13v8"/><path d="M8 17l4 4 4-4"/><path d="M20.74 12.74A5 5 0 0 0 18 5h-1.26A8 8 0 1 0 4 13.25"/></svg>"""),
        "gear" => new(
            """<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M12 1v2M12 21v2M4.2 4.2l1.4 1.4M18.4 18.4l1.4 1.4M1 12h2M21 12h2M4.2 19.8l1.4-1.4M18.4 5.6l1.4-1.4"/></svg>"""),
        _ => new("")
    };

    private sealed record NavItemDef(string Href, string Label, string? Description = null, string? Icon = null);

    private sealed class NavLinkDef
    {
        public string Key { get; }
        public string Label { get; }
        public string? Href { get; }
        public bool Submenu { get; }
        public string Type { get; }
        public IReadOnlyList<NavItemDef> Items { get; }

        public NavLinkDef(string key, string label, string href)
        {
            Key = key;
            Label = label;
            Href = href;
            Submenu = false;
            Type = "link";
            Items = [];
        }

        public NavLinkDef(string key, string label, IReadOnlyList<NavItemDef> items, string type)
        {
            Key = key;
            Label = label;
            Href = null;
            Submenu = true;
            Type = type;
            Items = items;
        }
    }
}
