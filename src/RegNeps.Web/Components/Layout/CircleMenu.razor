@inject CurrentUserService CurrentUser

@if (_items.Count > 0)
{
    <div class="circle-menu" style="--cm-size: @ContainerSizePx; --cm-item: @ItemSizePx;">
        <input type="checkbox" id="circle-menu-toggle" class="circle-menu-input" />

        <div class="circle-menu-stage">
            <div class="circle-menu-orbit" aria-hidden="true">
                @for (var i = 0; i < _items.Count; i++)
                {
                    var item = _items[i];
                    var point = PointOnCircle(i, _items.Count, ContainerSize / 2.0);
                    <a href="@item.Href"
                       class="circle-menu-item"
                       style="--tx: @(point.X.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture))px; --ty: @(point.Y.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture))px; --i: @i;"
                       title="@item.Label"
                       aria-label="@item.Label">
                        <span class="circle-menu-item-icon" aria-hidden="true">@MarkupIcon(item.Icon)</span>
                        <span class="circle-menu-item-label">@item.Label</span>
                    </a>
                }
            </div>

            <label for="circle-menu-toggle" class="circle-menu-trigger" aria-label="Abrir o cerrar menú rápido">
                <span class="circle-menu-icon circle-menu-icon-open" aria-hidden="true">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="4" x2="20" y1="12" y2="12" /><line x1="4" x2="20" y1="6" y2="6" /><line x1="4" x2="20" y1="18" y2="18" />
                    </svg>
                </span>
                <span class="circle-menu-icon circle-menu-icon-close" aria-hidden="true">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M18 6 6 18" /><path d="m6 6 12 12" />
                    </svg>
                </span>
            </label>
        </div>

        <label for="circle-menu-toggle" class="circle-menu-scrim" aria-hidden="true"></label>
    </div>
}

@code {
    private const double ContainerSize = 250;
    private const double ItemSize = 48;

    private string ContainerSizePx => $"{ContainerSize:0}px";
    private string ItemSizePx => $"{ItemSize:0}px";

    private List<CircleItem> _items = [];

    protected override async Task OnInitializedAsync()
    {
        var session = await CurrentUser.GetAsync();
        _items = BuildItems(session);
    }

    private static List<CircleItem> BuildItems(UserSession? session)
    {
        var items = new List<CircleItem>();
        if (session is null)
            return items;

        if (session.Has(AppPermission.ViewDashboard))
            items.Add(new("dashboard", "Inicio", "home"));
        if (session.Has(AppPermission.CaptureRecords))
            items.Add(new("captura", "Captura", "plus"));
        if (session.Has(AppPermission.ViewRecords))
            items.Add(new("registros", "Registros", "list"));
        if (session.Has(AppPermission.ViewAlerts))
            items.Add(new("alertas", "Alertas", "alert"));
        if (session.Has(AppPermission.ViewDashboard))
            items.Add(new("graficas", "Gráficas", "chart"));
        if (session.Has(AppPermission.ExportReports))
            items.Add(new("reportes", "Reportes", "file"));
        if (session.Has(AppPermission.ManageUsers))
            items.Add(new("usuarios", "Usuarios", "users"));
        if (session.Has(AppPermission.ViewSettings))
            items.Add(new("config", "Config", "gear"));

        return items;
    }

    private static (double X, double Y) PointOnCircle(int index, int total, double radius)
    {
        var theta = (2 * Math.PI * index) / total - Math.PI / 2;
        return (radius * Math.Cos(theta), radius * Math.Sin(theta));
    }

    private static MarkupString MarkupIcon(string icon) => icon switch
    {
        "home" => new("""<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>"""),
        "plus" => new("""<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M8 12h8"/><path d="M12 8v8"/></svg>"""),
        "list" => new("""<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 6h13"/><path d="M8 12h13"/><path d="M8 18h13"/><path d="M3 6h.01"/><path d="M3 12h.01"/><path d="M3 18h.01"/></svg>"""),
        "alert" => new("""<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3"/><path d="M12 9v4"/><path d="M12 17h.01"/></svg>"""),
        "chart" => new("""<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 3v18h18"/><path d="M18 17V9"/><path d="M13 17V5"/><path d="M8 17v-3"/></svg>"""),
        "file" => new("""<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/></svg>"""),
        "users" => new("""<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>"""),
        "gear" => new("""<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M12 1v2M12 21v2M4.2 4.2l1.4 1.4M18.4 18.4l1.4 1.4M1 12h2M21 12h2M4.2 19.8l1.4-1.4M18.4 5.6l1.4-1.4"/></svg>"""),
        _ => new("")
    };

    private sealed record CircleItem(string Href, string Label, string Icon);
}
