@page "/usuarios"
@rendermode InteractiveServer
@inject UserAdminService Users
@inject CurrentUserService CurrentUser

<PageTitle>Usuarios — RegNeps</PageTitle>

@if (!_allowed)
{
    <div class="alert alert-warning" role="alert">No tiene permiso para gestionar usuarios.</div>
}
else
{
    <PageHeader Title="Usuarios" Subtitle="Alta, roles y estado de cuentas de la intranet." />

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="alert alert-danger" role="alert">@_error</div>
    }
    @if (!string.IsNullOrEmpty(_message))
    {
        <div class="alert alert-success" role="status">@_message</div>
    }

    <div class="card border-0 shadow-sm mb-4" style="max-width: 640px;">
        <div class="card-body">
            <h2 class="h5 card-title">Crear usuario</h2>
            <div class="row g-2">
                <div class="col-md-4">
                    <label class="form-label" for="usr-username">Usuario *</label>
                    <input id="usr-username" class="form-control" @bind="_newUsername" autocomplete="off" />
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="usr-password">Contraseña *</label>
                    <input id="usr-password" class="form-control" type="password" @bind="_newPassword" autocomplete="new-password" />
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="usr-role">Rol</label>
                    <select id="usr-role" class="form-select" @bind="_newRole">
                        @foreach (var role in _creatableRoles)
                        {
                            <option value="@role">@role.ToDisplayLabel()</option>
                        }
                    </select>
                </div>
                <div class="col-12">
                    <button class="btn btn-primary btn-sm" @onclick="CreateAsync" disabled="@_saving" aria-busy="@_saving">Crear</button>
                </div>
            </div>
        </div>
    </div>

    <div class="table-responsive rn-table-wrap" style="max-width: 920px;">
        <table class="table table-sm table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th scope="col">Usuario</th>
                    <th scope="col">Nombre</th>
                    <th scope="col">Rol</th>
                    <th scope="col">Estado</th>
                    <th scope="col"><span class="visually-hidden">Acciones</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in _list.Where(x => x.DeletedAt is null))
                {
                    <tr>
                        <td>@u.Username</td>
                        <td>@u.EffectiveDisplayName</td>
                        <td>
                            @if (_canChangeRoles && !u.IsSuperAdmin && u.Role != AppUserRole.SuperAdmin)
                            {
                                <select class="form-select form-select-sm" style="width: auto; min-width: 8rem;"
                                        @onchange="e => OnRoleChangedAsync(u, e)">
                                    @foreach (var role in _creatableRoles)
                                    {
                                        if (u.EffectiveRole == role)
                                        {
                                            <option value="@role" selected>@role.ToDisplayLabel()</option>
                                        }
                                        else
                                        {
                                            <option value="@role">@role.ToDisplayLabel()</option>
                                        }
                                    }
                                </select>
                            }
                            else
                            {
                                @u.EffectiveRole.ToDisplayLabel()
                            }
                        </td>
                        <td>@(u.IsActive ? "Activo" : "Inactivo")</td>
                        <td class="text-nowrap">
                            <button class="btn btn-link btn-sm p-0 me-2" @onclick="() => ToggleActiveAsync(u)">
                                @(u.IsActive ? "Desactivar" : "Activar")
                            </button>
                            <button class="btn btn-link btn-sm p-0 me-2" @onclick="() => OpenReset(u)">Reset pass</button>
                            @if (_canDelete)
                            {
                                <button class="btn btn-link btn-sm text-danger p-0" @onclick="() => SoftDeleteAsync(u.Id)">Eliminar</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (_resetTarget is not null)
    {
        <AppModal Title="@($"Reset contraseña — {_resetTarget.Username}")" OnClose="CloseReset">
            <ChildContent>
            <label class="form-label" for="reset-password">Nueva contraseña (mín. 6)</label>
            <input id="reset-password" class="form-control" type="password" @bind="_resetPassword" autocomplete="new-password" />
            </ChildContent>
            <Footer>
                <button class="btn btn-secondary" @onclick="CloseReset">Cancelar</button>
                <button class="btn btn-primary" @onclick="ResetPasswordAsync">Guardar</button>
            </Footer>
        </AppModal>
    }
}

@code {
    private IReadOnlyList<AppUser> _list = [];
    private UserSession? _session;
    private bool _allowed;
    private bool _canDelete;
    private bool _canChangeRoles;
    private bool _saving;
    private string? _error;
    private string? _message;

    private string _newUsername = "";
    private string _newPassword = "";
    private AppUserRole _newRole = AppUserRole.Operario;
    private readonly AppUserRole[] _creatableRoles =
    [
        AppUserRole.Operario,
        AppUserRole.Supervisor,
        AppUserRole.Admin,
        AppUserRole.Gerencia
    ];

    private AppUser? _resetTarget;
    private string _resetPassword = "";

    private void CloseReset()
    {
        _resetTarget = null;
        _resetPassword = "";
    }
    protected override async Task OnInitializedAsync()
    {
        _session = await CurrentUser.GetAsync();
        _allowed = _session?.Has(AppPermission.ManageUsers) == true;
        _canDelete = _session?.Has(AppPermission.DeleteUsers) == true;
        _canChangeRoles = _session?.Has(AppPermission.ChangeRoles) == true;
        if (_allowed)
        {
            await LoadAsync();
        }
    }

    private CallerContext RequireCaller() =>
        _session?.ToCaller() ?? throw new UnauthorizedAccessException("No tiene permiso para gestionar usuarios.");

    private async Task LoadAsync() => _list = await Users.ListAsync(RequireCaller());

    private async Task CreateAsync()
    {
        _error = null;
        _message = null;
        _saving = true;
        try
        {
            await Users.CreateAsync(_newUsername, _newPassword, _newRole, null, null, RequireCaller());
            _message = "Usuario creado.";
            _newUsername = "";
            _newPassword = "";
            _newRole = AppUserRole.Operario;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task OnRoleChangedAsync(AppUser user, ChangeEventArgs e)
    {
        if (e.Value is null || !Enum.TryParse<AppUserRole>(e.Value.ToString(), out var role))
        {
            return;
        }

        if (role == user.EffectiveRole)
        {
            return;
        }

        try
        {
            await Users.UpdateRoleAsync(user.Id, role, RequireCaller());
            _message = $"Rol de {user.Username} actualizado a {role.ToDisplayLabel()}.";
            _error = null;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            await LoadAsync();
        }
    }

    private async Task ToggleActiveAsync(AppUser user)
    {
        try
        {
            await Users.SetActiveAsync(user.Id, !user.IsActive, RequireCaller());
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private void OpenReset(AppUser user)
    {
        _resetTarget = user;
        _resetPassword = "";
    }

    private async Task ResetPasswordAsync()
    {
        if (_resetTarget is null)
        {
            return;
        }

        try
        {
            await Users.ResetPasswordAsync(_resetTarget.Id, _resetPassword, RequireCaller());
            _message = "Contraseña actualizada.";
            CloseReset();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task SoftDeleteAsync(Guid id)
    {
        try
        {
            await Users.SoftDeleteAsync(id, RequireCaller());
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }
}
