@page "/usuarios"
@rendermode InteractiveServer
@inject UserAdminService Users
@inject RoleAdminService RoleAdmin
@inject CurrentUserService CurrentUser
@using RegNeps.Domain.Constants
@using RegNeps.Domain.Entities

<PageTitle>Usuarios — RegNeps</PageTitle>
<PermissionRefresh OnChanged="RefreshAccessAsync" />

@if (!_allowed)
{
    <div class="alert alert-warning" role="alert">No tiene permiso para gestionar usuarios.</div>
}
else
{
    <PageHeader Title="Usuarios" Subtitle="Alta, roles y estado de cuentas de la intranet." />

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="alert alert-danger" role="alert">@_error</div>
    }
    @if (!string.IsNullOrEmpty(_message))
    {
        <div class="alert alert-success" role="status">@_message</div>
    }

    <div class="card border-0 shadow-sm mb-4" style="max-width: 640px;">
        <div class="card-body">
            <h2 class="h5 card-title">Crear usuario</h2>
            <div class="row g-2">
                <div class="col-md-4">
                    <label class="form-label" for="usr-username">Usuario *</label>
                    <input id="usr-username" class="form-control" @bind="_newUsername" autocomplete="off" />
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="usr-password">Contraseña * (mín. 8, letras y números)</label>
                    <input id="usr-password" class="form-control" type="password" @bind="_newPassword" autocomplete="new-password" />
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="usr-role">Rol</label>
                    <select id="usr-role" class="form-select" @bind="_newRoleCode">
                        @foreach (var role in _assignableRoles)
                        {
                            if (SystemRoleCodes.IsSuperAdminCode(role.Code))
                            {
                                continue;
                            }

                            <option value="@role.Code">@role.Name</option>
                        }
                    </select>
                </div>
                <div class="col-12">
                    <button class="btn btn-primary btn-sm" @onclick="CreateAsync" disabled="@_saving" aria-busy="@_saving">Crear</button>
                </div>
            </div>
        </div>
    </div>

    <div class="table-responsive rn-table-wrap" style="max-width: 920px;">
        <table class="table table-sm table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th scope="col">Usuario</th>
                    <th scope="col">Nombre</th>
                    <th scope="col">Rol</th>
                    <th scope="col">Estado</th>
                    <th scope="col"><span class="visually-hidden">Acciones</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in _list.Where(x => x.DeletedAt is null))
                {
                    <tr>
                        <td>@u.Username</td>
                        <td>@u.EffectiveDisplayName</td>
                        <td>
                            @if (_canChangeRoles && !u.IsSuperAdmin && u.Role != AppUserRole.SuperAdmin)
                            {
                                <select class="form-select form-select-sm" style="width: auto; min-width: 8rem;"
                                        @onchange="e => OnRoleChangedAsync(u, e)">
                                    @foreach (var role in _assignableRoles)
                                    {
                                        if (SystemRoleCodes.IsSuperAdminCode(role.Code))
                                        {
                                            continue;
                                        }

                                        var selected = string.Equals(u.EffectiveRoleCode, role.Code, StringComparison.OrdinalIgnoreCase);
                                        if (selected)
                                        {
                                            <option value="@role.Code" selected>@role.Name</option>
                                        }
                                        else
                                        {
                                            <option value="@role.Code">@role.Name</option>
                                        }
                                    }
                                </select>
                            }
                            else
                            {
                                @RoleLabel(u)
                            }
                        </td>
                        <td>@(u.IsActive ? "Activo" : "Inactivo")</td>
                        <td class="text-nowrap">
                            <button class="btn btn-link btn-sm p-0 me-2" @onclick="() => ToggleActiveAsync(u)">
                                @(u.IsActive ? "Desactivar" : "Activar")
                            </button>
                            <button class="btn btn-link btn-sm p-0 me-2" @onclick="() => OpenReset(u)">Reset pass</button>
                            @if (_canDelete)
                            {
                                <button class="btn btn-link btn-sm text-danger p-0" @onclick="() => SoftDeleteAsync(u.Id)">Eliminar</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (_resetTarget is not null)
    {
        <AppModal Title="@($"Reset contraseña — {_resetTarget.Username}")" OnClose="CloseReset">
            <ChildContent>
            <label class="form-label" for="reset-password">Nueva contraseña (mín. 8, letras y números)</label>
            <input id="reset-password" class="form-control" type="password" @bind="_resetPassword" autocomplete="new-password" />
            @if (!string.IsNullOrEmpty(_resetValidationError))
            {
                <div class="text-danger small mt-2" role="alert">@_resetValidationError</div>
            }
            </ChildContent>
            <Footer>
                <button class="btn btn-secondary" @onclick="CloseReset">Cancelar</button>
                <button class="btn btn-primary" @onclick="ResetPasswordAsync">Guardar</button>
            </Footer>
        </AppModal>
    }
}

@code {
    private IReadOnlyList<AppUser> _list = [];
    private UserSession? _session;
    private bool _allowed;
    private bool _canDelete;
    private bool _canChangeRoles;
    private bool _saving;
    private string? _error;
    private string? _message;

    private string _newUsername = "";
    private string _newPassword = "";
    private string _newRoleCode = SystemRoleCodes.Operario;
    private IReadOnlyList<AppRole> _assignableRoles = [];

    private AppUser? _resetTarget;
    private string _resetPassword = "";
    private string? _resetValidationError;

    private void CloseReset()
    {
        _resetTarget = null;
        _resetPassword = "";
        _resetValidationError = null;
    }

    /// <summary>Misma regla que UserAdminService.ValidatePasswordStrength.</summary>
    private static string? ValidatePasswordClient(string password)
    {
        if (string.IsNullOrWhiteSpace(password) || password.Length < 8)
        {
            return "La contraseña debe tener al menos 8 caracteres.";
        }

        if (!password.Any(char.IsLetter) || !password.Any(char.IsDigit))
        {
            return "La contraseña debe incluir letras y números.";
        }

        return null;
    }
    private bool _usersReady;

    protected override async Task OnInitializedAsync() => await RefreshAccessAsync();

    private async Task RefreshAccessAsync()
    {
        _session = await CurrentUser.GetAsync();
        var allowed = _session?.Has(AppPermission.ManageUsers) == true;
        _canDelete = _session?.Has(AppPermission.DeleteUsers) == true;
        _canChangeRoles = _session?.Has(AppPermission.ChangeRoles) == true;
        if (!allowed)
        {
            _allowed = false;
            return;
        }

        _allowed = true;
        if (!_usersReady)
        {
            await LoadAsync();
            _usersReady = true;
        }
    }

    private CallerContext RequireCaller() =>
        _session?.ToCaller() ?? throw new UnauthorizedAccessException("No tiene permiso para gestionar usuarios.");

    private async Task LoadAsync()
    {
        _assignableRoles = await RoleAdmin.ListAssignableAsync();
        _list = await Users.ListAsync(RequireCaller());
    }

    private string RoleLabel(AppUser user)
    {
        var code = user.EffectiveRoleCode;
        var match = _assignableRoles.FirstOrDefault(r =>
            string.Equals(r.Code, code, StringComparison.OrdinalIgnoreCase));
        if (match is not null)
        {
            return match.Name;
        }

        if (SystemRoleCodes.TryParseEnum(code, out var enumRole))
        {
            return enumRole.ToDisplayLabel();
        }

        return code;
    }

    private async Task CreateAsync()
    {
        _error = null;
        _message = null;
        _saving = true;
        try
        {
            await Users.CreateAsync(_newUsername, _newPassword, _newRoleCode, null, null, RequireCaller());
            _message = "Usuario creado.";
            _newUsername = "";
            _newPassword = "";
            _newRoleCode = SystemRoleCodes.Operario;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task OnRoleChangedAsync(AppUser user, ChangeEventArgs e)
    {
        var roleCode = e.Value?.ToString()?.Trim();
        if (string.IsNullOrWhiteSpace(roleCode))
        {
            return;
        }

        if (string.Equals(roleCode, user.EffectiveRoleCode, StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        try
        {
            await Users.UpdateRoleAsync(user.Id, roleCode, RequireCaller());
            _message = $"Rol de {user.Username} actualizado.";
            _error = null;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            await LoadAsync();
        }
    }

    private async Task ToggleActiveAsync(AppUser user)
    {
        try
        {
            await Users.SetActiveAsync(user.Id, !user.IsActive, RequireCaller());
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private void OpenReset(AppUser user)
    {
        _resetTarget = user;
        _resetPassword = "";
        _resetValidationError = null;
    }

    private async Task ResetPasswordAsync()
    {
        if (_resetTarget is null)
        {
            return;
        }

        _resetValidationError = ValidatePasswordClient(_resetPassword);
        if (_resetValidationError is not null)
        {
            return;
        }

        try
        {
            await Users.ResetPasswordAsync(_resetTarget.Id, _resetPassword, RequireCaller());
            _message = "Contraseña actualizada.";
            CloseReset();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task SoftDeleteAsync(Guid id)
    {
        try
        {
            await Users.SoftDeleteAsync(id, RequireCaller());
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }
}
