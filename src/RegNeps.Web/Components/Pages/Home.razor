@page "/"
@rendermode InteractiveServer
@inject NavigationManager Navigation
@inject CurrentUserService CurrentUser

<PageTitle>RegNeps VICUNHA</PageTitle>

<p class="rn-loading" role="status">
    <span class="rn-spinner" aria-hidden="true"></span>
    <span>Redirigiendo…</span>
</p>

@code {
    protected override async Task OnInitializedAsync()
    {
        var session = await CurrentUser.GetAsync();
        Navigation.NavigateTo(session is not null ? "/dashboard" : "/login", replace: true);
    }
}
