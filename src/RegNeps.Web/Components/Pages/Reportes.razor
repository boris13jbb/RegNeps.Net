@page "/reportes"
@rendermode InteractiveServer
@inject NavigationManager Nav

<PageTitle>Informes — RegNeps</PageTitle>
<p class="rn-loading" role="status">
    <span class="rn-spinner" aria-hidden="true"></span>
    <span>Abriendo exportación…</span>
</p>

@code {
    protected override void OnInitialized()
    {
        var query = Nav.ToAbsoluteUri(Nav.Uri).Query;
        Nav.NavigateTo("/exportar" + query, replace: true);
    }
}
