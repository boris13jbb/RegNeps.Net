@page "/reportes"
@rendermode InteractiveServer
@inject ReportExportAppService Reports
@inject CurrentUserService CurrentUser
@inject RegNeps.Web.Export.TempExportStore TempStore
@inject NavigationManager Nav

<PageTitle>Reportes profesionales — RegNeps</PageTitle>

@if (!_allowed)
{
    <div class="alert alert-warning" role="alert">No tiene permiso para exportar reportes.</div>
}
else
{
    <PageHeader Title="Reportes profesionales"
                Subtitle="Vista previa y descarga de un informe consolidado con todos los registros del periodo (fechas incluidas)." />

    <div class="rn-filters" style="max-width: 720px;">
    <div class="row g-2 align-items-end">
        <div class="col-md-3">
            <label class="rn-field-label" for="reportes-desde">Desde</label>
            <InputDate id="reportes-desde" class="form-control" @bind-Value="_fromLocal" />
        </div>
        <div class="col-md-3">
            <label class="rn-field-label" for="reportes-hasta">Hasta</label>
            <InputDate id="reportes-hasta" class="form-control" @bind-Value="_toLocal" />
        </div>
        <div class="col-md-2">
            <label class="rn-field-label" for="reportes-telar">Telar</label>
            <input id="reportes-telar" class="form-control" @bind="_telar" placeholder="Opcional" />
        </div>
        <div class="col-md-2">
            <label class="rn-field-label" for="reportes-tela">Tela</label>
            <input id="reportes-tela" class="form-control" @bind="_tela" placeholder="Opcional" />
        </div>
        <div class="col-md-2">
            <button class="btn btn-primary w-100" @onclick="PreviewAsync" disabled="@_loading">
                @(_loading ? "…" : "Vista previa")
            </button>
        </div>
    </div>
    </div>

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="alert alert-warning" role="alert">@_error</div>
    }

    @if (_preview is not null)
    {
        @if (_preview.Records.Count == 0)
        {
            <EmptyState Title="Sin registros en el rango"
                        Message="@($"No hay registros entre {_fromLocal?.ToString("dd/MM/yyyy")} y {_toLocal?.ToString("dd/MM/yyyy")}. Ajuste las fechas e intente de nuevo.")" />
        }
        else
        {
            <div class="alert alert-success py-2" role="status">
                Consolidado: <strong>@_preview.Records.Count</strong> registros
                del @_fromLocal?.ToString("dd/MM/yyyy") al @_toLocal?.ToString("dd/MM/yyyy")
                (orden cronológico).
            </div>

            <div class="mb-3">
                <h2 class="rn-section-title">Conclusiones</h2>
                <ul>
                    @foreach (var c in _preview.Conclusions)
                    {
                        <li>@c</li>
                    }
                </ul>
            </div>

            <div class="row g-3 mb-4">
                <div class="col-6 col-md-3">
                    <KpiCard Label="Registros">@_preview.Summary.TotalRecords</KpiCard>
                </div>
                <div class="col-6 col-md-3">
                    <KpiCard Label="Promedio">@_preview.Summary.AverageNeps.ToString("0.##")</KpiCard>
                </div>
                <div class="col-6 col-md-3">
                    <KpiCard Label="Críticos" Tone="danger">@_preview.Summary.CriticalCount</KpiCard>
                </div>
                <div class="col-6 col-md-3">
                    <KpiCard Label="Calidad" Tone="success">@_preview.Summary.QualityIndex.ToString("0.#")%</KpiCard>
                </div>
            </div>

            <div class="row g-4 mb-4">
                <div class="col-lg-6">
                    <h2 class="rn-section-title">Peores telares</h2>
                    @if (_preview.Summary.WorstTelars.Count == 0)
                    {
                        <p class="text-muted">Sin datos.</p>
                    }
                    else
                    {
                        <div class="rn-table-wrap table-responsive">
                            <table class="table table-sm table-hover mb-0">
                                <thead>
                                    <tr>
                                        <th scope="col">Telar</th>
                                        <th scope="col">Promedio</th>
                                        <th scope="col">Regs</th>
                                        <th scope="col">Crít.</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var t in _preview.Summary.WorstTelars)
                                    {
                                        <tr>
                                            <td>@t.Key</td>
                                            <td>@t.AverageNeps.ToString("0.##")</td>
                                            <td>@t.RecordCount</td>
                                            <td>@t.CriticalCount</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
                <div class="col-lg-6">
                    <h2 class="rn-section-title">Mejores telares</h2>
                    @if (_preview.Summary.BestTelars.Count == 0)
                    {
                        <p class="text-muted">Sin datos.</p>
                    }
                    else
                    {
                        <div class="rn-table-wrap table-responsive">
                            <table class="table table-sm table-hover mb-0">
                                <thead>
                                    <tr>
                                        <th scope="col">Telar</th>
                                        <th scope="col">Promedio</th>
                                        <th scope="col">Regs</th>
                                        <th scope="col">Crít.</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var t in _preview.Summary.BestTelars)
                                    {
                                        <tr>
                                            <td>@t.Key</td>
                                            <td>@t.AverageNeps.ToString("0.##")</td>
                                            <td>@t.RecordCount</td>
                                            <td>@t.CriticalCount</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>

            <h2 class="rn-section-title">Tendencia diaria</h2>
            @if (_preview.Summary.ByDay.Count == 0)
            {
                <p class="text-muted">Sin puntos en el periodo.</p>
            }
            else
            {
                <div class="rn-table-wrap table-responsive mb-4" style="max-width: 480px;">
                    <table class="table table-sm table-hover mb-0">
                        <thead>
                            <tr>
                                <th scope="col">Fecha</th>
                                <th scope="col">Promedio</th>
                                <th scope="col">Cantidad</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var d in _preview.Summary.ByDay)
                            {
                                <tr>
                                    <td>@d.Date.ToString("dd/MM/yyyy")</td>
                                    <td>@d.AverageNeps.ToString("0.##")</td>
                                    <td>@d.Count</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            <div class="d-flex gap-2 flex-wrap align-items-center">
                <select class="form-select form-select-sm" style="width: auto;" @bind="_style">
                    <option value="completo">Estilo Completo</option>
                    <option value="clasico">Estilo Clásico</option>
                </select>
                <button class="btn btn-outline-danger" disabled="@_exporting" @onclick='() => DownloadAsync("pdf")'>Exportar PDF</button>
                <button class="btn btn-outline-success" disabled="@_exporting" @onclick='() => DownloadAsync("xlsx")'>Exportar Excel</button>
                <button class="btn btn-outline-secondary" disabled="@_exporting" @onclick='() => DownloadAsync("csv")'>Exportar CSV</button>
            </div>
        }
    }
}

@code {
    private bool _allowed;
    private UserSession? _session;
    private DateTime? _fromLocal = DateTime.Today.AddDays(-30);
    private DateTime? _toLocal = DateTime.Today;
    private string _telar = "";
    private string _tela = "";
    private string _style = "completo";
    private ProfessionalReportPreview? _preview;
    private bool _loading;
    private bool _exporting;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        _session = await CurrentUser.GetAsync();
        _allowed = _session?.Has(AppPermission.ExportReports) == true;
        if (!_allowed || _session is null)
        {
            return;
        }

        ApplyQueryFilters();
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);
        if (query.TryGetValue("auto", out var auto) &&
            auto.ToString() is "1" or "true" &&
            _fromLocal is not null &&
            _toLocal is not null)
        {
            await PreviewAsync();
        }
    }

    /// <summary>Abre Reportes desde Informes con ?from=&amp;to=&amp;telar=&amp;tela=&amp;auto=1.</summary>
    private void ApplyQueryFilters()
    {
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);
        if (query.Count == 0)
        {
            return;
        }

        if (query.TryGetValue("from", out var fromRaw) &&
            query.TryGetValue("to", out var toRaw) &&
            ReportDateRange.TryParseQuery(fromRaw.ToString(), toRaw.ToString(), out var range, out _))
        {
            _fromLocal = range.FromUtc.ToLocalTime().Date;
            _toLocal = range.ToInclusiveUtc.ToLocalTime().Date;
        }

        if (query.TryGetValue("telar", out var telarRaw) && !string.IsNullOrWhiteSpace(telarRaw))
        {
            _telar = telarRaw.ToString();
        }

        if (query.TryGetValue("tela", out var telaRaw) && !string.IsNullOrWhiteSpace(telaRaw))
        {
            _tela = telaRaw.ToString();
        }
    }

    private bool TryBuildRange(out ReportDateRange range)
    {
        range = default;
        if (_fromLocal is null || _toLocal is null)
        {
            _error = "Debe indicar fecha inicial y fecha final.";
            return false;
        }

        if (_fromLocal.Value.Date > _toLocal.Value.Date)
        {
            _error = "La fecha inicial no puede ser posterior a la fecha final.";
            return false;
        }

        range = ReportDateRange.FromLocalCalendarDates(_fromLocal.Value, _toLocal.Value);
        return true;
    }

    private async Task PreviewAsync()
    {
        if (_session is null || !TryBuildRange(out var range))
        {
            return;
        }

        _loading = true;
        _error = null;
        try
        {
            _preview = await Reports.BuildProfessionalPreviewAsync(
                range.FromUtc,
                range.ToInclusiveUtc,
                _session.UserId,
                _session.SeesAllRecords,
                _telar,
                _tela);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            _preview = null;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task DownloadAsync(string format)
    {
        if (_session is null || !TryBuildRange(out var range))
        {
            return;
        }

        _exporting = true;
        _error = null;
        try
        {
            var filters = new RecordFilters
            {
                Telar = string.IsNullOrWhiteSpace(_telar) ? null : _telar.Trim(),
                Tela = string.IsNullOrWhiteSpace(_tela) ? null : _tela.Trim()
            };
            range.ApplyTo(filters);

            var file = await Reports.ExportAsync(
                format, filters, _session.UserId, _session.SeesAllRecords, _style);
            var id = TempStore.Put(file.Bytes, file.ContentType, file.FileName, _session.UserId);
            Nav.NavigateTo($"/api/export/temp/{id}", forceLoad: true);
        }
        catch (InvalidOperationException ex)
        {
            _error = ex.Message;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _exporting = false;
        }
    }
}
