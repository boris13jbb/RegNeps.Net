@page "/Error"
@layout Layout.EmptyLayout
@attribute [AllowAnonymous]
@using System.Diagnostics

<PageTitle>Error — RegNeps</PageTitle>

<div class="rn-error-page">
    <div class="rn-error-card" role="alert">
        <h1>No se pudo completar la solicitud</h1>
        <p class="rn-error-lead mb-3">
            Ocurrió un error al procesar la petición. Puede volver al inicio e intentarlo de nuevo.
        </p>

        @if (ShowRequestId)
        {
            <p class="small text-muted mb-3">
                <strong>ID de solicitud:</strong> <code>@RequestId</code>
            </p>
        }

        <div class="d-flex flex-wrap gap-2 mb-3">
            <a class="btn btn-primary" href="/">Ir al inicio</a>
            <a class="btn btn-outline-secondary" href="/login">Iniciar sesión</a>
        </div>

        <details class="small text-muted">
            <summary>Notas para desarrollo</summary>
            <p class="mt-2 mb-1">
                En entorno <strong>Development</strong> se muestra más detalle del error.
                No active Development en servidores de intranet de producción.
            </p>
        </details>
    </div>
</div>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
