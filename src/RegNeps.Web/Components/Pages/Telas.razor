@page "/telas"
@rendermode InteractiveServer
@inject IFabricRepository Fabrics
@inject IFabricImportService FabricImport
@inject CurrentUserService CurrentUser

<PageTitle>Telas — RegNeps</PageTitle>

@if (!_allowed)
{
    <div class="alert alert-warning" role="alert">No tiene permiso para gestionar telas.</div>
}
else
{
    <PageHeader Title="Telas" Subtitle="Catálogo de telas y referencias usadas en captura.">
        <Actions>
            <InputFile class="form-control form-control-sm" style="max-width: 260px;" OnChange="OnImportFile"
                       accept=".xlsx,.xls" disabled="@_importing" aria-label="Importar telas desde Excel" />
            <a class="btn btn-outline-secondary btn-sm" href="/api/export/fabrics/csv">CSV</a>
            <a class="btn btn-outline-secondary btn-sm" href="/api/export/fabrics/xlsx">Excel</a>
        </Actions>
    </PageHeader>

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="alert alert-danger" role="alert">@_error</div>
    }
    @if (!string.IsNullOrEmpty(_message))
    {
        <div class="alert alert-success" role="status">@_message</div>
    }

    <div class="card border-0 shadow-sm mb-4" style="max-width: 560px;">
        <div class="card-body">
            <h2 class="h5 card-title">@( _editing is null ? "Nueva tela" : "Editar tela" )</h2>
            <div class="row g-2">
                <div class="col-md-6">
                    <label class="form-label">Nombre *</label>
                    <input class="form-control" @bind="_name" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Código</label>
                    <input class="form-control" @bind="_code" />
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" id="active" @bind="_isActive" />
                        <label class="form-check-label" for="active">Activa</label>
                    </div>
                </div>
                <div class="col-12">
                    <button class="btn btn-primary btn-sm" @onclick="SaveAsync" disabled="@_saving">
                        @(_saving ? "Guardando…" : "Guardar")
                    </button>
                    @if (_editing is not null)
                    {
                        <button class="btn btn-outline-secondary btn-sm ms-2" @onclick="CancelEdit">Cancelar</button>
                    }
                </div>
            </div>
            <p class="text-muted small mb-0 mt-2">
                Importar Excel: columna Tela o Nombre (opcional Codigo). Fusiona sin borrar existentes.
            </p>
        </div>
    </div>

    <div class="table-responsive rn-table-wrap" style="max-width: 720px;">
        <table class="table table-sm table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th scope="col">Nombre</th>
                    <th scope="col">Código</th>
                    <th scope="col">Estado</th>
                    <th scope="col"><span class="visually-hidden">Acciones</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var f in _list)
                {
                    <tr>
                        <td>@f.Name</td>
                        <td>@(f.Code ?? "—")</td>
                        <td>
                            <StatusBadge Tone="@(f.IsActive ? "normal" : "muted")">
                                @(f.IsActive ? "Activa" : "Inactiva")
                            </StatusBadge>
                        </td>
                        <td class="text-nowrap">
                            <button class="btn btn-link btn-sm p-0 me-2" @onclick="() => StartEdit(f)">Editar</button>
                            <button class="btn btn-link btn-sm text-danger p-0" @onclick="() => DeleteAsync(f.Id)">Eliminar</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private IReadOnlyList<Fabric> _list = [];
    private bool _allowed;
    private string _name = "";
    private string _code = "";
    private bool _isActive = true;
    private Fabric? _editing;
    private bool _saving;
    private bool _importing;
    private string? _error;
    private string? _message;

    protected override async Task OnInitializedAsync()
    {
        var session = await CurrentUser.GetAsync();
        _allowed = session?.Has(AppPermission.ManageFabrics) == true;
        if (_allowed)
        {
            await LoadAsync();
        }
    }

    private async Task LoadAsync() => _list = await Fabrics.GetAllAsync();

    private void StartEdit(Fabric f)
    {
        _editing = f;
        _name = f.Name;
        _code = f.Code ?? "";
        _isActive = f.IsActive;
        _message = null;
        _error = null;
    }

    private void CancelEdit()
    {
        _editing = null;
        _name = "";
        _code = "";
        _isActive = true;
    }

    private async Task OnImportFile(InputFileChangeEventArgs e)
    {
        _error = null;
        _message = null;
        var file = e.File;
        if (file is null || file.Size == 0)
        {
            _error = "Seleccione un archivo Excel válido.";
            return;
        }

        if (file.Size > 5 * 1024 * 1024)
        {
            _error = "El archivo supera 5 MB.";
            return;
        }

        _importing = true;
        try
        {
            await using var stream = file.OpenReadStream(5 * 1024 * 1024);
            await using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            ms.Position = 0;
            var result = await FabricImport.ImportExcelAsync(ms);
            if (result.Errors.Count > 0 && result.Added == 0 && result.Updated == 0)
            {
                _error = string.Join(" ", result.Errors);
            }
            else
            {
                _message = $"Importación: {result.Added} nuevas, {result.Updated} actualizadas, {result.Skipped} omitidas.";
                if (result.Errors.Count > 0)
                {
                    _message += " " + string.Join(" ", result.Errors);
                }
            }

            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = "No se pudo importar el Excel: " + ex.Message;
        }
        finally
        {
            _importing = false;
        }
    }

    private async Task SaveAsync()
    {
        _error = null;
        _message = null;
        if (string.IsNullOrWhiteSpace(_name))
        {
            _error = "El nombre es obligatorio.";
            return;
        }

        _saving = true;
        try
        {
            if (_editing is null)
            {
                await Fabrics.AddAsync(new Fabric
                {
                    Name = _name.Trim(),
                    Code = string.IsNullOrWhiteSpace(_code) ? null : _code.Trim(),
                    IsActive = _isActive
                });
                _message = "Tela creada.";
            }
            else
            {
                _editing.Name = _name.Trim();
                _editing.Code = string.IsNullOrWhiteSpace(_code) ? null : _code.Trim();
                _editing.IsActive = _isActive;
                await Fabrics.UpdateAsync(_editing);
                _message = "Tela actualizada.";
            }

            CancelEdit();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task DeleteAsync(Guid id)
    {
        try
        {
            await Fabrics.DeleteAsync(id);
            if (_editing?.Id == id)
            {
                CancelEdit();
            }

            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }
}
