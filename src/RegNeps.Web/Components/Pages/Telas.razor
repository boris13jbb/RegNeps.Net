@page "/telas"
@rendermode InteractiveServer
@inject IFabricRepository Fabrics
@inject IFabricImportService FabricImport
@inject CurrentUserService CurrentUser

<PageTitle>Telas — RegNeps</PageTitle>
<PermissionRefresh OnChanged="RefreshAccessAsync" />

@if (!_allowed)
{
    <div class="alert alert-warning" role="alert">No tiene permiso para gestionar telas.</div>
}
else
{
    <PageHeader Title="Telas" Subtitle="Catálogo usado al capturar. Los lotes están en la pestaña de al lado.">
        <Actions>
            <InputFile class="form-control form-control-sm" style="max-width: 260px;" OnChange="OnImportFile"
                       accept=".xlsx,.xls" disabled="@_importing" aria-label="Importar telas desde Excel" />
            <a class="btn btn-outline-secondary btn-sm" href="/api/export/fabrics/csv">CSV</a>
            <a class="btn btn-outline-secondary btn-sm" href="/api/export/fabrics/xlsx">Excel</a>
        </Actions>
    </PageHeader>

    <HubTabs AriaLabel="Catálogo" Tabs="CatalogoTabs" />

    @if (!string.IsNullOrEmpty(_error) && _editing is null)
    {
        <div class="alert alert-danger" role="alert">@_error</div>
    }
    @if (!string.IsNullOrEmpty(_message))
    {
        <div class="alert alert-success" role="status">@_message</div>
    }

    <div class="card border-0 shadow-sm mb-4" style="max-width: 560px;">
        <div class="card-body">
            <h2 class="h5 card-title">Nueva tela</h2>
            <div class="row g-2">
                <div class="col-md-6">
                    <label class="form-label" for="tela-nombre">Nombre *</label>
                    <input id="tela-nombre" class="form-control" @bind="_name" maxlength="128" />
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="tela-codigo">Código</label>
                    <input id="tela-codigo" class="form-control" @bind="_code" maxlength="64" />
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" id="active" @bind="_isActive" />
                        <label class="form-check-label" for="active">Activa</label>
                    </div>
                </div>
                <div class="col-12">
                    <button type="button" class="btn btn-primary btn-sm" @onclick="SaveNewAsync" disabled="@_saving">
                        @(_saving ? "Guardando…" : "Guardar")
                    </button>
                </div>
            </div>
            <p class="text-muted small mb-0 mt-2">
                Importar Excel: columna Tela o Nombre (opcional Codigo). Fusiona sin borrar existentes.
            </p>
        </div>
    </div>

    <div class="table-responsive rn-table-wrap" style="max-width: 720px;">
        <table class="table table-sm table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th scope="col">Nombre</th>
                    <th scope="col">Código</th>
                    <th scope="col">Estado</th>
                    <th scope="col"><span class="visually-hidden">Acciones</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var f in _list)
                {
                    <tr class="@(_editing?.Id == f.Id ? "table-active" : null)">
                        <td>@f.Name</td>
                        <td>@(f.Code ?? "—")</td>
                        <td>
                            <StatusBadge Tone="@(f.IsActive ? "normal" : "muted")">
                                @(f.IsActive ? "Activa" : "Inactiva")
                            </StatusBadge>
                        </td>
                        <td class="text-nowrap">
                            <button type="button" class="btn btn-link btn-sm p-0 me-2"
                                    @onclick="() => StartEdit(f)" @onclick:stopPropagation="true">
                                Editar
                            </button>
                            <button type="button" class="btn btn-link btn-sm text-danger p-0"
                                    @onclick="() => DeleteAsync(f.Id)" @onclick:stopPropagation="true">
                                Eliminar
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (_editing is not null)
    {
        <AppModal Title="@($"Editar tela — {_editing.Name}")" OnClose="CancelEdit">
            <ChildContent>
                @if (!string.IsNullOrEmpty(_error))
                {
                    <div class="alert alert-danger" role="alert">@_error</div>
                }
                <div class="mb-3">
                    <label class="form-label" for="edit-tela-nombre">Nombre *</label>
                    <input id="edit-tela-nombre" class="form-control" @bind="_editName" maxlength="128" />
                </div>
                <div class="mb-3">
                    <label class="form-label" for="edit-tela-codigo">Código</label>
                    <input id="edit-tela-codigo" class="form-control" @bind="_editCode" maxlength="64" />
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="edit-tela-activa" @bind="_editIsActive" />
                    <label class="form-check-label" for="edit-tela-activa">Activa</label>
                </div>
            </ChildContent>
            <Footer>
                <button type="button" class="btn btn-secondary" @onclick="CancelEdit">Cancelar</button>
                <button type="button" class="btn btn-primary" @onclick="SaveEditAsync" disabled="@_saving">
                    @(_saving ? "Guardando…" : "Guardar cambios")
                </button>
            </Footer>
        </AppModal>
    }
}

@code {
    private IReadOnlyList<Fabric> _list = [];
    private bool _allowed;
    private string _name = "";
    private string _code = "";
    private bool _isActive = true;
    private string _editName = "";
    private string _editCode = "";
    private bool _editIsActive = true;
    private Fabric? _editing;
    private bool _saving;
    private bool _importing;
    private string? _error;
    private string? _message;

    private static readonly IReadOnlyList<(string Href, string Label)> CatalogoTabs =
    [
        ("/telas", "Telas"),
        ("/lotes", "Lotes")
    ];

    private bool _catalogReady;

    protected override async Task OnInitializedAsync() => await RefreshAccessAsync();

    private async Task RefreshAccessAsync()
    {
        var session = await CurrentUser.GetAsync();
        var allowed = session?.Has(AppPermission.ManageFabrics) == true;
        if (!allowed)
        {
            _allowed = false;
            return;
        }

        _allowed = true;
        if (!_catalogReady)
        {
            await LoadAsync();
            _catalogReady = true;
        }
    }

    private async Task LoadAsync() => _list = await Fabrics.GetAllAsync();

    private void StartEdit(Fabric f)
    {
        _editing = f;
        _editName = f.Name;
        _editCode = f.Code ?? "";
        _editIsActive = f.IsActive;
        _message = null;
        _error = null;
    }

    private void CancelEdit()
    {
        _editing = null;
        _editName = "";
        _editCode = "";
        _editIsActive = true;
    }

    private async Task OnImportFile(InputFileChangeEventArgs e)
    {
        _error = null;
        _message = null;
        if (!await CurrentUser.HasAsync(AppPermission.ManageFabrics))
        {
            _error = "No tiene permiso para esta operación.";
            return;
        }
        var file = e.File;
        if (file is null || file.Size == 0)
        {
            _error = "Seleccione un archivo Excel válido.";
            return;
        }

        if (file.Size > 5 * 1024 * 1024)
        {
            _error = "El archivo supera 5 MB.";
            return;
        }

        _importing = true;
        try
        {
            await using var stream = file.OpenReadStream(5 * 1024 * 1024);
            await using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            ms.Position = 0;
            var result = await FabricImport.ImportExcelAsync(ms);
            if (result.Errors.Count > 0 && result.Added == 0 && result.Updated == 0)
            {
                _error = string.Join(" ", result.Errors);
            }
            else
            {
                _message = $"Importación: {result.Added} nuevas, {result.Updated} actualizadas, {result.Skipped} omitidas.";
                if (result.Errors.Count > 0)
                {
                    _message += " " + string.Join(" ", result.Errors);
                }
            }

            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = "No se pudo importar el Excel: " + ex.Message;
        }
        finally
        {
            _importing = false;
        }
    }

    private Task SaveNewAsync() => PersistAsync(
        name: _name,
        code: _code,
        isActive: _isActive,
        existing: null);

    private Task SaveEditAsync() => PersistAsync(
        name: _editName,
        code: _editCode,
        isActive: _editIsActive,
        existing: _editing);

    private async Task PersistAsync(string name, string code, bool isActive, Fabric? existing)
    {
        _error = null;
        _message = null;
        if (string.IsNullOrWhiteSpace(name))
        {
            _error = "El nombre es obligatorio.";
            return;
        }

        if (!await CurrentUser.HasAsync(AppPermission.ManageFabrics))
        {
            _error = "No tiene permiso para esta operación.";
            return;
        }

        _saving = true;
        try
        {
            if (existing is null)
            {
                await Fabrics.AddAsync(new Fabric
                {
                    Name = name.Trim(),
                    Code = string.IsNullOrWhiteSpace(code) ? null : code.Trim(),
                    IsActive = isActive
                });
                _message = "Tela creada.";
                _name = "";
                _code = "";
                _isActive = true;
            }
            else
            {
                existing.Name = name.Trim();
                existing.Code = string.IsNullOrWhiteSpace(code) ? null : code.Trim();
                existing.IsActive = isActive;
                await Fabrics.UpdateAsync(existing);
                _message = "Tela actualizada.";
                CancelEdit();
            }

            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task DeleteAsync(Guid id)
    {
        if (!await CurrentUser.HasAsync(AppPermission.ManageFabrics))
        {
            _error = "No tiene permiso para esta operación.";
            return;
        }

        try
        {
            await Fabrics.DeleteAsync(id);
            if (_editing?.Id == id)
            {
                CancelEdit();
            }

            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }
}
