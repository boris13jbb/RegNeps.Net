@page "/alertas"
@rendermode InteractiveServer
@inject NepRecordService RecordService
@inject IAlertConfigRepository AlertConfigRepository
@inject CurrentUserService CurrentUser

<PageTitle>Alertas — RegNeps</PageTitle>
<PermissionRefresh OnChanged="RefreshAccessAsync" />

@if (!_allowed)
{
    <div class="alert alert-warning" role="alert">No tiene permiso para ver alertas.</div>
}
else
{
    <PageHeader Title="Alertas" Subtitle="Umbrales, reincidencias y acciones correctivas pendientes.">
        <Actions>
            <button class="btn btn-outline-primary btn-sm" @onclick="LoadAsync" disabled="@_loading" aria-busy="@_loading">
                @(_loading ? "Cargando…" : "Actualizar")
            </button>
        </Actions>
    </PageHeader>

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="alert alert-danger" role="alert">@_error</div>
    }

    @if (_loading && _alerts.Count == 0)
    {
        <LoadingBlock Message="Cargando alertas…" />
    }
    else if (_alerts.Count == 0)
    {
        <EmptyState Title="Sin alertas activas"
                    Message="No hay mediciones por encima de umbral ni pendientes de revisión." />
    }
    else
    {
        <div class="rn-alert-list" style="max-width: 900px;">
            @foreach (var r in _alerts)
            {
                var level = r.GetAlertLevel(_config);
                var itemTone = level == AlertLevel.Critico ? "rn-alert-item--critical"
                    : level == AlertLevel.Advertencia ? "rn-alert-item--warning"
                    : "";
                <div class="rn-alert-item @itemTone">
                    <div class="d-flex justify-content-between align-items-start gap-2 flex-wrap">
                        <div>
                            <StatusBadge Tone="@BadgeTone(level)">@level.ToDisplayLabel()</StatusBadge>
                            <strong class="ms-2">Telar @r.Telar</strong> — @r.Neps.ToString("0.##") neps
                            <div class="small text-muted mt-1">
                                @r.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                @if (!string.IsNullOrWhiteSpace(r.Tela))
                                {
                                    <span> · @r.Tela</span>
                                }
                                @if (r.RequiereSeguimiento(_config))
                                {
                                    <span class="text-danger fw-semibold"> · Pendiente revisión</span>
                                }
                            </div>
                        </div>
                        @if (_canCorrect)
                        {
                            <button class="btn btn-sm btn-outline-primary" @onclick="() => OpenCorrective(r)">Acción correctiva</button>
                        }
                    </div>
                </div>
            }
        </div>
    }

    @if (_correctiveTarget is not null)
    {
        <AppModal Title="@($"Acción correctiva — Telar {_correctiveTarget.Telar}")" OnClose="CloseCorrective">
            <ChildContent>
            <div class="mb-3">
                <label class="form-label" for="corrective-accion">Acción *</label>
                <textarea id="corrective-accion" class="form-control" rows="3" @bind="_accion" required></textarea>
            </div>
            <div class="mb-3">
                <label class="form-label" for="corrective-responsable">Responsable</label>
                <input id="corrective-responsable" class="form-control" @bind="_responsable" />
            </div>
            </ChildContent>
            <Footer>
                <button class="btn btn-secondary" @onclick="CloseCorrective">Cancelar</button>
                <button class="btn btn-primary" @onclick="SaveCorrectiveAsync" disabled="@_saving">Guardar</button>
            </Footer>
        </AppModal>
    }
}

@code {
    private IReadOnlyList<NepRecord> _alerts = [];
    private AlertConfig _config = new();
    private bool _loading = true;
    private bool _allowed;
    private bool _canCorrect;
    private UserSession? _session;
    private string? _error;

    private NepRecord? _correctiveTarget;
    private string _accion = "";
    private string _responsable = "";
    private bool _saving;

    private bool _alertsReady;

    protected override async Task OnInitializedAsync() => await RefreshAccessAsync();

    private async Task RefreshAccessAsync()
    {
        _session = await CurrentUser.GetAsync();
        var allowed = _session?.Has(AppPermission.ViewAlerts) == true;
        _canCorrect = _session?.Has(AppPermission.ApplyCorrectiveAction) == true;
        if (!allowed)
        {
            _allowed = false;
            if (!_canCorrect)
            {
                _correctiveTarget = null;
            }

            return;
        }

        _allowed = true;
        if (!_alertsReady)
        {
            await LoadAsync();
            _alertsReady = true;
        }
    }

    private async Task LoadAsync()
    {
        if (_session is null)
        {
            return;
        }

        _loading = true;
        try
        {
            _config = await AlertConfigRepository.GetAsync();
            _alerts = await RecordService.GetAlertsAsync(_session.ToActor());
        }
        finally
        {
            _loading = false;
        }
    }

    private void OpenCorrective(NepRecord record)
    {
        _correctiveTarget = record;
        _accion = record.AccionCorrectiva;
        _responsable = _session?.DisplayName ?? "";
    }

    private void CloseCorrective() => _correctiveTarget = null;

    private async Task SaveCorrectiveAsync()
    {
        if (_correctiveTarget is null)
        {
            return;
        }

        if (!await CurrentUser.HasAsync(AppPermission.ApplyCorrectiveAction))
        {
            await RefreshAccessAsync();
            _error = "No tiene permiso para acciones correctivas.";
            return;
        }

        _saving = true;
        _error = null;
        try
        {
            await RecordService.ApplyCorrectiveAsync(new CorrectiveActionRequest
            {
                RecordId = _correctiveTarget.Id,
                Accion = _accion,
                Responsable = _responsable,
                MarcarRevisado = true
            }, _session!.ToActor());
            CloseCorrective();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private static string BadgeTone(AlertLevel level) => level switch
    {
        AlertLevel.Advertencia => "warning",
        AlertLevel.Critico => "critical",
        AlertLevel.Normal => "normal",
        _ => "muted"
    };
}
