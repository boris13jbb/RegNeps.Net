    private void ClearOpenedReportState(bool clearQuery)
    {
        _openedReportId = null;
        _openedReportName = null;
        _preferSnapshot = false;
        _openedFromInforme = false;
        _informeSavedCount = 0;
        if (clearQuery)
        {
            Nav.NavigateTo("/registros", forceLoad: true);
        }
    }

    private async Task CloseOpenedReportAsync()
    {
        RecordSelectionRules.ClearOnPageOrFilterChange(_selectedIds);
        _page = 1;
        ClearOpenedReportState(clearQuery: true);
        _message = "Informe cerrado. Mostrando registros en vivo.";
        await Task.CompletedTask;
    }

    private string BuildFilteredEmptyMessage()
    {
        var hasDates = IsUsableDate(_filterFrom) || IsUsableDate(_filterTo);
        var range = hasDates
            ? $" entre {(_filterFrom ?? _filterTo):dd/MM/yyyy} y {(_filterTo ?? _filterFrom):dd/MM/yyyy}"
            : "";
        var saved = _informeSavedCount > 0
            ? $" El informe recordaba {_informeSavedCount} filas en ese periodo, pero ya no están en la base."
            : "";
        return $"Hay {_totalInDb} mediciones en total, pero ninguna coincide con los filtros actuales{range}.{saved} Amplíe fechas o limpie filtros.";
    }

    /// <summary>InputDate a veces deja DateTime.MinValue; no debe usarse como filtro real.</summary>
    private static bool IsUsableDate(DateTime? value) =>
        value is { Year: >= 2000 };

    private Task FilterAsync()
    {
        _preferSnapshot = false;
        RecordSelectionRules.ClearOnPageOrFilterChange(_selectedIds);
        _page = 1;
        return LoadAsync();
    }

    private async Task GoToPageAsync(int page)
    {
        RecordSelectionRules.ClearOnPageOrFilterChange(_selectedIds);
        var target = Math.Clamp(page, 1, TotalPages);
        if (target == _page && !_pagingFromSnapshot)
        {
            return;
        }

        _page = target;
        if (_pagingFromSnapshot)
        {
            return;
        }

        await LoadAsync();
    }

    private void ClearSelection() => _selectedIds.Clear();

    private void ToggleRow(Guid id, ChangeEventArgs e)
    {
        var on = e.Value is bool b && b;
        if (on)
        {
            _selectedIds.Add(id);
        }
        else
        {
            _selectedIds.Remove(id);
        }
    }

    private void ToggleSelectAllPage(ChangeEventArgs e)
    {
        var on = e.Value is bool b && b;
        var pageIds = PageRecords.Select(r => r.Id).ToList();
        if (on)
        {
            foreach (var id in pageIds)
            {
                _selectedIds.Add(id);
            }
        }
        else
        {
            foreach (var id in pageIds)
            {
                _selectedIds.Remove(id);
            }
        }
    }

    private void EditSelectedAsync()
    {
        if (_isReadOnlyView || !RecordSelectionRules.CanEditSelection(_selectedIds.Count) || !_canEdit)
        {
            return;
        }

        var id = _selectedIds.First();
        var record = PageRecords.FirstOrDefault(r => r.Id == id)
                     ?? _records.FirstOrDefault(r => r.Id == id);
        if (record is not null)
        {
            OpenEdit(record);
        }
    }

    private void ConfirmDeleteSelectedAsync()
    {
        if (_isReadOnlyView)
        {
            return;
        }

        _confirmDeleteSelected = true;
    }

    private async Task DeleteSelectedAsync()
    {
        if (_isReadOnlyView || _session is null || !_canDelete)
        {
            return;
        }

        _deletingSelected = true;
        _error = null;
        try
        {
            var result = await RecordService.DeleteManyAsync(_selectedIds.ToList(), _session.ToActor());
            foreach (var id in result.DeletedIds.Concat(result.FailedIds))
            {
                _selectedIds.Remove(id);
            }

            _message = result.SummaryText;
            _confirmDeleteSelected = false;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _deletingSelected = false;
        }
    }

    private void OpenSaveReportModal()
    {
        if (_isReadOnlyView)
        {
            return;
        }

        _saveReportName = $"Informe {DateTime.Now:yyyyMMdd_HHmmss}";
        _showSaveReportModal = true;
    }

    private async Task SaveReportFromSelectionAsync()
    {
        if (_isReadOnlyView || _session is null || !_canManageReports || _selectedIds.Count == 0)
        {
            return;
        }

        _savingReport = true;
        _error = null;
        try
        {
            var report = await ExportService.SaveReportByIdsAsync(
                _saveReportName,
                _selectedIds.ToList(),
                _session.UserId,
                _session.DisplayName,
                _session.SeesAllRecords,
                hasManageReports: true);
            _message = $"Informe «{report.Name}» guardado con {report.RecordCount} registros.";
            _showSaveReportModal = false;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _savingReport = false;
        }
    }

    private async Task LoadAsync()
    {
        if (_session is null)
        {
            return;
        }

        _loading = true;
        _error = null;
        try
        {
            // Contar siempre al refrescar: evita estado vacío obsoleto tras captura/migración.
            _totalInDb = await RecordService.CountAllAsync();
            _config = await AlertConfigRepository.GetAsync();
            AlertLevel? alert = null;
            if (!string.IsNullOrEmpty(_filterAlert) &&
                AlertLevelExtensions.TryParseFilter(_filterAlert, out var parsed))
            {
                alert = parsed;
            }

            if (_openedReportId is Guid reportId)
            {
                try
                {
                    var access = _session.ToReportAccessActor();
                    var saved = await ExportService.GetAccessibleSavedAsync(reportId, access);
                    _openedReportName = saved.Name;

                    if (_preferSnapshot)
                    {
                        var snapshot = await ExportService.LoadAccessibleSnapshotAsync(reportId, access);
                        if (snapshot.Count > 0)
                        {
                            // Snapshot: ya materializado por diseño del informe; paginación solo en memoria.
                            _pagingFromSnapshot = true;
                            _records = snapshot;
                            _filteredTotal = snapshot.Count;
                            _totalInDb = await RecordService.CountAllAsync();
                            if (_page > TotalPages)
                            {
                                _page = TotalPages;
                            }

                            RecordSelectionRules.PruneToVisible(_selectedIds, PageRecords.Select(r => r.Id));
                            _message =
                                $"Informe abierto: {snapshot.Count} mediciones restauradas y mostradas " +
                                $"(el informe recordaba {(_informeSavedCount > 0 ? _informeSavedCount : snapshot.Count)} filas).";
                            return;
                        }
                    }
                }
                catch (InvalidOperationException)
                {
                    // Sin revelar existencia: limpiar modo informe y continuar con listado vivo.
                    ClearOpenedReportState(clearQuery: false);
                    _error = SavedReportAccess.NotFoundMessage;
                }
            }

            // Descarta fechas inválidas que InputDate puede dejar en el modelo.
            if (!IsUsableDate(_filterFrom))
            {
                _filterFrom = null;
            }

            if (!IsUsableDate(_filterTo))
            {
                _filterTo = null;
            }

            var filters = new RecordFilters
            {
                Telar = string.IsNullOrWhiteSpace(_filterTelar) ? null : _filterTelar.Trim(),
                Tela = string.IsNullOrWhiteSpace(_filterTela) ? null : _filterTela.Trim(),
                LoteTrama = string.IsNullOrWhiteSpace(_filterLote) ? null : _filterLote.Trim(),
                Turno = string.IsNullOrWhiteSpace(_filterTurno) ? null : _filterTurno.Trim(),
                AlertLevel = alert,
                SoloPendientes = _soloPendientes
            };

            if (_filterFrom is not null || _filterTo is not null)
            {
                var fromDay = (_filterFrom ?? _filterTo)!.Value.Date;
                var toDay = (_filterTo ?? _filterFrom)!.Value.Date;
                if (fromDay > toDay)
                {
                    _error = "La fecha inicial no puede ser posterior a la fecha final.";
                    _records = [];
                    return;
                }

                ReportDateRange.FromLocalCalendarDates(fromDay, toDay).ApplyTo(filters);
            }

            // FASE 2F: solo la página solicitada (filtros + auth + ORDER en SQL).
            _pagingFromSnapshot = false;
            var paged = await RecordService.QueryPagedAsync(
                filters,
                _session.ToActor(),
                pageNumber: _page,
                pageSize: PageSize,
                RecordQueryScope.Default);
            _records = paged.Items;
            _filteredTotal = paged.TotalCount;
            _page = paged.PageNumber;

            RecordSelectionRules.PruneToVisible(_selectedIds, PageRecords.Select(r => r.Id));
        }
        catch (Exception ex)
        {
            _error = $"No se pudieron cargar los registros: {ex.Message}";
            _records = [];
            _filteredTotal = 0;
            _pagingFromSnapshot = false;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OnImportAsync(InputFileChangeEventArgs e)
    {
        if (_isReadOnlyView)
        {
            _error = "No puede importar mientras visualiza un informe guardado (solo lectura).";
            return;
        }

        if (_session is null || !await CurrentUser.HasAsync(AppPermission.EditRecords))
        {
            await RefreshAccessAsync();
            _error = "No tiene permiso para esta operación.";
            return;
        }

        _message = null;
        _error = null;
        _importRows = null;
        try
        {
            await using var stream = e.File.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            var result = await ImportService.ImportFileAsync(
                stream,
                e.File.Name,
                _session.UserId,
                _session.Username,
                _session.EffectiveRole.ToString());
            _importRows = result.Rows;
            _message = $"Importados: {result.Imported}." +
                       (result.Errors.Count > 0 ? $" Errores: {result.Errors.Count}." : "");
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private void OpenEdit(NepRecord record)
    {
        if (_isReadOnlyView)
        {
            return;
        }

        _editTarget = record;
        _editTelar = record.Telar;
        _editNeps = record.Neps;
        _editTela = record.Tela;
        _editLote = record.LoteTrama;
        _editTurno = record.Turno;
        _editOperario = record.Operario;
        _editLinea = record.LineaProduccion;
        _editObservacion = record.Observacion;
        _error = null;
    }

    private void CloseEdit() => _editTarget = null;

    private async Task SaveEditAsync()
    {
        if (_isReadOnlyView)
        {
            _error = "No puede editar registros en modo solo lectura de informe.";
            return;
        }

        if (_editTarget is null || !await CurrentUser.HasAsync(AppPermission.EditRecords))
        {
            await RefreshAccessAsync();
            _error = "No tiene permiso para editar registros.";
            return;
        }

        _savingEdit = true;
        _error = null;
        try
        {
            await RecordService.UpdateAsync(new UpdateNepRecordRequest
            {
                Id = _editTarget.Id,
                Telar = _editTelar,
                Neps = _editNeps,
                Tela = _editTela,
                LoteTrama = _editLote,
                Turno = _editTurno,
                Operario = _editOperario,
                LineaProduccion = _editLinea,
                Observacion = _editObservacion,
                ExpectedConcurrencyStamp = _editTarget.ConcurrencyStamp
            }, _session!.ToActor());
            _message = "Registro actualizado.";
            CloseEdit();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _savingEdit = false;
        }
    }

    private void OpenCorrective(NepRecord record)
    {
        if (_isReadOnlyView)
        {
            return;
        }

        _correctiveTarget = record;
        _accion = record.AccionCorrectiva;
        _responsable = string.IsNullOrWhiteSpace(record.ResponsableRevision)
            ? _session?.DisplayName ?? ""
            : record.ResponsableRevision;
        _marcarRevisado = true;
    }

    private void CloseCorrective() => _correctiveTarget = null;

    private async Task SaveCorrectiveAsync()
    {
        if (_correctiveTarget is null)
        {
            return;
        }

        if (_isReadOnlyView)
        {
            _error = "No puede registrar acciones correctivas en modo solo lectura.";
            return;
        }

        if (!await CurrentUser.HasAsync(AppPermission.ApplyCorrectiveAction))
        {
            await RefreshAccessAsync();
            _error = "No tiene permiso para acciones correctivas.";
            return;
        }

        _savingCorrective = true;
        _error = null;
        try
        {
            await RecordService.ApplyCorrectiveAsync(new CorrectiveActionRequest
            {
                RecordId = _correctiveTarget.Id,
                Accion = _accion,
                Responsable = _responsable,
                MarcarRevisado = _marcarRevisado
            }, _session!.ToActor());
            CloseCorrective();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _savingCorrective = false;
        }
    }

    private async Task ClearAllAsync()
    {
        if (_isReadOnlyView)
        {
            _confirmClearAll = false;
            _error = "No puede vaciar registros mientras visualiza un informe guardado.";
            return;
        }

        if (!await CurrentUser.HasAsync(AppPermission.ClearAllRecords))
        {
            await RefreshAccessAsync();
            _confirmClearAll = false;
            _error = "No tiene permiso para vaciar registros.";
            return;
        }

        _error = null;
        _message = null;
        try
        {
            await RecordService.ClearAllAsync(_session!.ToActor());
            _totalInDb = 0;
            _message =
                "Todas las mediciones fueron eliminadas (tombstones de sync generados). " +
                "Los informes guardados siguen existiendo; al abrirlos la tabla viva puede salir vacía " +
                "hasta que capture o migre datos de nuevo. Los dispositivos offline se actualizarán al sincronizar.";
            _confirmClearAll = false;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _confirmClearAll = false;
            _error = ex.Message;
        }
    }

    private async Task DeleteAsync(Guid id)
    {
        if (_isReadOnlyView)
        {
            _error = "No puede eliminar registros en modo solo lectura de informe.";
            return;
        }

        if (!await CurrentUser.HasAsync(AppPermission.DeleteRecords))
        {
            await RefreshAccessAsync();
            _error = "No tiene permiso para eliminar registros.";
            return;
        }

        try
        {
            await RecordService.DeleteAsync(id, _session!.ToActor());
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private static string BadgeTone(AlertLevel level) => level switch
    {
        AlertLevel.Ok => "normal",
        AlertLevel.Mention => "warning",
        AlertLevel.CriticalAdjustment => "critical",
        AlertLevel.SecondQuality => "critical",
        _ => "muted"
    };
}
