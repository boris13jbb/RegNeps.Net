@page "/registros"
@rendermode InteractiveServer
@inject NepRecordService RecordService
@inject ReportExportAppService ExportService
@inject IAlertConfigRepository AlertConfigRepository
@inject IRecordImportService ImportService
@inject CurrentUserService CurrentUser
@inject NavigationManager Nav
@using RegNeps.Application.Reports
@implements IDisposable

<PageTitle>Registros — RegNeps</PageTitle>
<PermissionRefresh OnChanged="RefreshAccessAsync" />

@if (!_allowed)
{
    <div class="alert alert-warning" role="alert">No tiene permiso para ver registros.</div>
}
else
{
    <PageHeader Title="Registros" Subtitle="Consulte, filtre e importe históricos de mediciones.">
        <Actions>
            @if (_canEditInUi)
            {
                <a class="btn btn-outline-secondary btn-sm" href="/api/import/template">Plantilla Excel</a>
                <label class="btn btn-outline-primary btn-sm mb-0">
                    Importar
                    <InputFile OnChange="OnImportAsync" accept=".xlsx,.xls,.csv" class="d-none" />
                </label>
            }
            @if (_canClearAllInUi)
            {
                <button class="btn btn-outline-danger btn-sm" @onclick="() => _confirmClearAll = true" disabled="@_loading">
                    Vaciar todos
                </button>
            }
            <button class="btn btn-outline-primary btn-sm" @onclick="LoadAsync" disabled="@_loading" aria-busy="@_loading">
                @(_loading ? "Cargando…" : "Actualizar")
            </button>
            @if (_isReadOnlyView)
            {
                <button type="button" class="btn btn-primary btn-sm" @onclick="CloseOpenedReportAsync">
                    Cerrar informe
                </button>
            }
        </Actions>
    </PageHeader>

    @if (_isReadOnlyView)
    {
        <div class="alert alert-info d-flex flex-wrap align-items-center gap-2" role="status" style="max-width: 1100px;">
            <span>
                Viendo informe guardado:
                <strong>@(_openedReportName ?? "Informe")</strong> (solo lectura)
            </span>
            <button type="button" class="btn btn-sm btn-outline-primary ms-auto" @onclick="CloseOpenedReportAsync">
                Cerrar informe
            </button>
        </div>
    }

    @if (!string.IsNullOrEmpty(_message))
    {
        <div class="alert alert-info" role="status">@_message</div>
    }
    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="alert alert-danger" role="alert">@_error</div>
    }
    @if (_openedFromInforme && _totalInDb == 0)
    {
        <div class="alert alert-warning" role="alert" style="max-width: 1100px;">
            <strong>La base de datos no tiene mediciones (0 registros).</strong>
            Si el informe no trae copia de filas, recargue la migración histórica o capture de nuevo.
            <div class="mt-2 d-flex flex-wrap gap-2">
                <a class="btn btn-primary btn-sm" href="/captura">Capturar mediciones</a>
                <a class="btn btn-outline-primary btn-sm" href="/migracion">Migración histórica (Firestore)</a>
                <a class="btn btn-outline-secondary btn-sm" href="/informes">Volver a Informes</a>
            </div>
        </div>
    }

    <div class="rn-filters" style="max-width: 1100px;">
        <div class="row g-2 align-items-end">
            <div class="col-6 col-md-2">
                <label class="rn-field-label" for="filter-telar">Telar</label>
                <input id="filter-telar" class="form-control form-control-sm" @bind="_filterTelar" />
            </div>
            <div class="col-6 col-md-2">
                <label class="rn-field-label" for="filter-tela">Tela</label>
                <input id="filter-tela" class="form-control form-control-sm" @bind="_filterTela" />
            </div>
            <div class="col-6 col-md-2">
                <label class="rn-field-label" for="filter-lote">Lote</label>
                <input id="filter-lote" class="form-control form-control-sm" @bind="_filterLote" />
            </div>
            <div class="col-6 col-md-1">
                <label class="rn-field-label" for="filter-turno">Turno</label>
                <select id="filter-turno" class="form-select form-select-sm" @bind="_filterTurno">
                    <option value="">Todos</option>
                    <option value="A">A</option>
                    <option value="B">B</option>
                    <option value="C">C</option>
                </select>
            </div>
            <div class="col-6 col-md-2">
                <label class="rn-field-label" for="filter-alerta">Alerta</label>
                <select id="filter-alerta" class="form-select form-select-sm" @bind="_filterAlert">
                    <option value="">Todas</option>
                    <option value="Ok">OK</option>
                    <option value="Mention">Mención</option>
                    <option value="CriticalAdjustment">Crítico - Realizar Ajuste</option>
                    <option value="SecondQuality">2da Calidad</option>
                </select>
            </div>
            <div class="col-6 col-md-1">
                <label class="rn-field-label" for="filter-desde">Desde</label>
                <InputDate id="filter-desde" class="form-control form-control-sm" @bind-Value="_filterFrom" />
            </div>
            <div class="col-6 col-md-1">
                <label class="rn-field-label" for="filter-hasta">Hasta</label>
                <InputDate id="filter-hasta" class="form-control form-control-sm" @bind-Value="_filterTo" />
            </div>
            <div class="col-6 col-md-1">
                <div class="form-check mb-1">
                    <input class="form-check-input" type="checkbox" id="pendientes" @bind="_soloPendientes" />
                    <label class="form-check-label" for="pendientes">Pendientes</label>
                </div>
            </div>
            <div class="col-12 col-md-auto">
                <button class="btn btn-primary btn-sm" @onclick="FilterAsync">Filtrar</button>
            </div>
        </div>
    </div>

    @if (_selectedIds.Count > 0)
    {
        <div class="alert alert-secondary d-flex flex-wrap align-items-center gap-2 py-2" role="status" style="max-width: 1100px;">
            <strong>@_selectedIds.Count seleccionados</strong>
            @if (_canEditInUi)
            {
                <button class="btn btn-sm btn-outline-primary"
                        disabled="@(!RecordSelectionRules.CanEditSelection(_selectedIds.Count))"
                        @onclick="EditSelectedAsync">
                    Editar
                </button>
            }
            @if (_canDeleteInUi)
            {
                <button class="btn btn-sm btn-outline-danger" @onclick="ConfirmDeleteSelectedAsync">
                    Eliminar seleccionados
                </button>
            }
            @if (_canManageReportsInUi)
            {
                <button class="btn btn-sm btn-outline-secondary" @onclick="OpenSaveReportModal">
                    Guardar informe de la selección
                </button>
            }
            <button class="btn btn-sm btn-link" @onclick="ClearSelection">Limpiar selección</button>
        </div>
    }

    @if (_importRows is { Count: > 0 })
    {
        <div class="card border-0 shadow-sm mb-3" style="max-width: 1100px;">
            <div class="card-body">
                <h2 class="h6">Resultado de importación</h2>
                <div class="table-responsive" style="max-height: 220px; overflow:auto;">
                    <table class="table table-sm mb-0">
                        <thead>
                            <tr>
                                <th>Fila</th>
                                <th>Estado</th>
                                <th>Motivo</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in _importRows)
                            {
                                <tr>
                                    <td>@row.RowNumber</td>
                                    <td>@(row.Success ? "OK" : "Error")</td>
                                    <td>@(row.Reason ?? "—")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    @if (_loading && _records.Count == 0)
    {
        <LoadingBlock Message="Cargando registros…" />
    }
    else if (_records.Count == 0)
    {
        @if (_totalInDb == 0)
        {
            <EmptyState Title="No hay mediciones en la base"
                        Message="@(_informeSavedCount > 0
                            ? $"La tabla de mediciones está vacía (0 filas), aunque el informe recordaba {_informeSavedCount} registros. Pulse «Ver datos» de nuevo tras reimportar el histórico, o capture mediciones."
                            : "La tabla NepRecords está vacía (0 filas). Capture mediciones o importe el histórico de Firestore.")">
                <a class="btn btn-primary btn-sm" href="/captura">Ir a captura</a>
                <a class="btn btn-outline-primary btn-sm" href="/migracion">Migración histórica</a>
                @if (_openedFromInforme)
                {
                    <a class="btn btn-outline-secondary btn-sm" href="/informes">Volver a Informes</a>
                }
            </EmptyState>
        }
        else
        {
            <EmptyState Title="Sin resultados con estos filtros"
                        Message="@BuildFilteredEmptyMessage()">
                <button type="button" class="btn btn-primary btn-sm" @onclick="ClearDatesAndReloadAsync">
                    Quitar filtro de fechas y ver todo
                </button>
                <button type="button" class="btn btn-outline-primary btn-sm" @onclick="ClearAllFiltersAndReloadAsync">
                    Limpiar todos los filtros
                </button>
                <a class="btn btn-outline-secondary btn-sm" href="/captura">Ir a captura</a>
            </EmptyState>
        }
    }
    else
    {
        <div class="rn-table-wrap table-responsive">
            <table class="table table-sm table-hover align-middle mb-0">
                <thead>
                    <tr>
                        @if (!_isReadOnlyView)
                        {
                            <th scope="col" style="width:2.5rem;">
                                <input class="form-check-input" type="checkbox"
                                       checked="@AllPageSelected"
                                       @onchange="ToggleSelectAllPage"
                                       aria-label="Seleccionar todos (página actual)" />
                            </th>
                        }
                        <th scope="col">Fecha</th>
                        <th scope="col">Telar</th>
                        <th scope="col">Neps</th>
                        <th scope="col">Mts</th>
                        <th scope="col">Tela</th>
                        <th scope="col">Lote</th>
                        <th scope="col">Turno</th>
                        <th scope="col">Operario</th>
                        <th scope="col">Alerta</th>
                        <th scope="col"><span class="visually-hidden">Acciones</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in PageRecords)
                    {
                        var level = r.GetAlertLevel(_config);
                        <tr>
                            @if (!_isReadOnlyView)
                            {
                                <td>
                                    <input class="form-check-input" type="checkbox"
                                           checked="@_selectedIds.Contains(r.Id)"
                                           @onchange="e => ToggleRow(r.Id, e)"
                                           aria-label="@($"Seleccionar {r.Telar}")" />
                                </td>
                            }
                            <td>@r.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@r.Telar</td>
                            <td>@r.Neps.ToString("0.##")</td>
                            <td>@r.MtsCalculados.ToString("0.##")</td>
                            <td>@r.Tela</td>
                            <td>@r.LoteTrama</td>
                            <td>@r.Turno</td>
                            <td>@r.Operario</td>
                            <td>
                                <StatusBadge Tone="@BadgeTone(level)">@level.ToDisplayLabel()</StatusBadge>
                            </td>
                            <td class="text-nowrap">
                                @if (_canEditInUi)
                                {
                                    <button class="btn btn-link btn-sm p-0 me-2" @onclick="() => OpenEdit(r)">Editar</button>
                                }
                                @if (_canCorrectInUi && level != AlertLevel.Ok)
                                {
                                    <button class="btn btn-link btn-sm p-0 me-2" @onclick="() => OpenCorrective(r)">Acción</button>
                                }
                                @if (_canDeleteInUi)
                                {
                                    <button class="btn btn-link btn-sm text-danger p-0" @onclick="() => DeleteAsync(r.Id)">Eliminar</button>
                                }
                                @if (_isReadOnlyView)
                                {
                                    <span class="small text-muted">Solo lectura</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="d-flex flex-wrap align-items-center gap-2 mt-2 mb-3" style="max-width: 1100px;">
            <span class="small text-muted">
                Página @_page de @TotalPages · @(_pagingFromSnapshot ? _records.Count : _filteredTotal) registros · @PageSize por página
            </span>
            <button class="btn btn-sm btn-outline-secondary" disabled="@(_page <= 1)" @onclick="() => GoToPageAsync(_page - 1)">Anterior</button>
            <button class="btn btn-sm btn-outline-secondary" disabled="@(_page >= TotalPages)" @onclick="() => GoToPageAsync(_page + 1)">Siguiente</button>
        </div>
    }

    @if (_editTarget is not null)
    {
        <AppModal Title="@($"Editar registro — {_editTarget.Telar}")" Size="lg" OnClose="CloseEdit">
            <ChildContent>
            <div class="row g-2">
                <div class="col-md-4">
                    <label class="form-label" for="edit-telar">Telar *</label>
                    <input id="edit-telar" class="form-control" @bind="_editTelar" />
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="edit-neps">Neps *</label>
                    <input id="edit-neps" class="form-control" type="number" step="0.01" @bind="_editNeps" />
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="edit-mts">Mts (calc.)</label>
                    <input id="edit-mts" class="form-control" value="@((_editNeps / NepsConstants.TestLengthM).ToString("0.##"))" disabled />
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="edit-tela">Tela</label>
                    <input id="edit-tela" class="form-control" @bind="_editTela" />
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="edit-lote">Lote/trama</label>
                    <input id="edit-lote" class="form-control" @bind="_editLote" />
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="edit-turno">Turno</label>
                    <select id="edit-turno" class="form-select" @bind="_editTurno">
                        <option value="">—</option>
                        <option value="A">A</option>
                        <option value="B">B</option>
                        <option value="C">C</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="edit-operario">Operario</label>
                    <input id="edit-operario" class="form-control" @bind="_editOperario" />
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="edit-linea">Línea</label>
                    <input id="edit-linea" class="form-control" @bind="_editLinea" />
                </div>
                <div class="col-12">
                    <label class="form-label" for="edit-obs">Observación</label>
                    <textarea id="edit-obs" class="form-control" rows="2" @bind="_editObservacion"></textarea>
                </div>
            </div>
            </ChildContent>
            <Footer>
                <button class="btn btn-secondary" @onclick="CloseEdit">Cancelar</button>
                <button class="btn btn-primary" @onclick="SaveEditAsync" disabled="@_savingEdit">Guardar</button>
            </Footer>
        </AppModal>
    }

    @if (_correctiveTarget is not null)
    {
        <AppModal Title="@($"Acción correctiva — Telar {_correctiveTarget.Telar}")" OnClose="CloseCorrective">
            <ChildContent>
            <div class="mb-3">
                <label class="form-label" for="reg-corrective-accion">Acción *</label>
                <textarea id="reg-corrective-accion" class="form-control" rows="3" @bind="_accion"></textarea>
            </div>
            <div class="mb-3">
                <label class="form-label" for="reg-corrective-resp">Responsable</label>
                <input id="reg-corrective-resp" class="form-control" @bind="_responsable" />
            </div>
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="revisado" @bind="_marcarRevisado" />
                <label class="form-check-label" for="revisado">Marcar como revisado</label>
            </div>
            </ChildContent>
            <Footer>
                <button class="btn btn-secondary" @onclick="CloseCorrective">Cancelar</button>
                <button class="btn btn-primary" @onclick="SaveCorrectiveAsync" disabled="@_savingCorrective">Guardar</button>
            </Footer>
        </AppModal>
    }

    @if (_confirmDeleteSelected)
    {
        <AppModal Title="Eliminar seleccionados" OnClose="() => _confirmDeleteSelected = false">
            <ChildContent>
                <p class="mb-0">¿Eliminar @_selectedIds.Count registro(s) seleccionados? Esta acción no se puede deshacer.</p>
            </ChildContent>
            <Footer>
                <button class="btn btn-secondary" @onclick="() => _confirmDeleteSelected = false">Cancelar</button>
                <button class="btn btn-danger" @onclick="DeleteSelectedAsync" disabled="@_deletingSelected">Eliminar</button>
            </Footer>
        </AppModal>
    }

    @if (_confirmClearAll)
    {
        <AppModal Title="Vaciar todos los registros" OnClose="() => _confirmClearAll = false">
            <ChildContent>
                <p>¿Eliminar <strong>todas</strong> las mediciones? Esta acción no se puede deshacer.</p>
                <p class="small text-muted mb-0">
                    Genera un tombstone de sincronización (<code>RecordDeleted</code>) por cada registro
                    para que los dispositivos offline actualicen su réplica al sincronizar.
                    Los informes guardados no se borran. Operación administrativa online.
                </p>
            </ChildContent>
            <Footer>
                <button class="btn btn-secondary" @onclick="() => _confirmClearAll = false">Cancelar</button>
                <button class="btn btn-danger" @onclick="ClearAllAsync" disabled="@_loading">Vaciar todos</button>
            </Footer>
        </AppModal>
    }

    @if (_showSaveReportModal)
    {
        <AppModal Title="Guardar informe de la selección" OnClose="() => _showSaveReportModal = false">
            <ChildContent>
                <label class="form-label" for="save-report-name">Nombre del informe</label>
                <input id="save-report-name" class="form-control" @bind="_saveReportName" />
                <p class="small text-muted mt-2 mb-0">Se guardarán @_selectedIds.Count registro(s) exactos.</p>
            </ChildContent>
            <Footer>
                <button class="btn btn-secondary" @onclick="() => _showSaveReportModal = false">Cancelar</button>
                <button class="btn btn-primary" @onclick="SaveReportFromSelectionAsync" disabled="@_savingReport">Guardar</button>
            </Footer>
        </AppModal>
    }
}

@code {
    private const int PageSize = RecordPaging.DefaultPageSize;

    /// <summary>Página actual (vivo) o snapshot completo (informe). No materializa todo el dataset vivo.</summary>
    private IReadOnlyList<NepRecord> _records = [];
    private int _filteredTotal;
    private bool _pagingFromSnapshot;
    private AlertConfig _config = new();
    private bool _loading = true;
    private bool _allowed;
    private bool _canEdit;
    private bool _canDelete;
    private bool _canClearAll;
    private bool _canCorrect;
    private bool _canManageReports;
    private UserSession? _session;
    private string? _message;
    private string? _error;

    private string _filterTelar = "";
    private string _filterTela = "";
    private string _filterLote = "";
    private string _filterTurno = "";
    private string _filterAlert = "";
    private DateTime? _filterFrom;
    private DateTime? _filterTo;
    private bool _soloPendientes;
    private bool _openedFromInforme;
    private int _totalInDb;
    private int _informeSavedCount;
    private Guid? _openedReportId;
    private string? _openedReportName;
    private bool _preferSnapshot;
    private string? _lastSessionUserId;

    private bool _isReadOnlyView => SavedReportViewMode.IsReadOnlyView(_openedReportId);
    private bool _canEditInUi => _canEdit && !_isReadOnlyView;
    private bool _canDeleteInUi => _canDelete && !_isReadOnlyView;
    private bool _canClearAllInUi => _canClearAll && !_isReadOnlyView;
    private bool _canCorrectInUi => _canCorrect && !_isReadOnlyView;
    private bool _canManageReportsInUi => _canManageReports && !_isReadOnlyView;

    private readonly HashSet<Guid> _selectedIds = [];
    private int _page = 1;
    private bool _confirmDeleteSelected;
    private bool _confirmClearAll;
    private bool _deletingSelected;
    private bool _showSaveReportModal;
    private string _saveReportName = "";
    private bool _savingReport;
    private IReadOnlyList<RecordImportRowResult>? _importRows;

    private NepRecord? _editTarget;
    private string _editTelar = "";
    private double _editNeps;
    private string _editTela = "";
    private string _editLote = "";
    private string _editTurno = "";
    private string _editOperario = "";
    private string _editLinea = "";
    private string _editObservacion = "";
    private bool _savingEdit;

    private NepRecord? _correctiveTarget;
    private string _accion = "";
    private string _responsable = "";
    private bool _marcarRevisado = true;
    private bool _savingCorrective;

    private bool _recordsReady;

    private int TotalPages =>
        Math.Max(1, (int)Math.Ceiling((_pagingFromSnapshot ? _records.Count : _filteredTotal) / (double)PageSize));

    private IReadOnlyList<NepRecord> PageRecords =>
        _pagingFromSnapshot
            ? _records.Skip((_page - 1) * PageSize).Take(PageSize).ToList()
            : _records;

    private bool AllPageSelected
    {
        get
        {
            var page = PageRecords;
            return page.Count > 0 && page.All(r => _selectedIds.Contains(r.Id));
        }
    }

    protected override async Task OnInitializedAsync() => await RefreshAccessAsync();

    private async Task RefreshAccessAsync()
    {
        _session = await CurrentUser.GetAsync();
        var newUserId = _session?.UserId;
        if (_recordsReady
            && _lastSessionUserId is not null
            && !string.Equals(_lastSessionUserId, newUserId, StringComparison.Ordinal))
        {
            _selectedIds.Clear();
            _editTarget = null;
            _correctiveTarget = null;
            _confirmDeleteSelected = false;
            _showSaveReportModal = false;
            if (_openedReportId is not null)
            {
                ClearOpenedReportState(clearQuery: true);
                _lastSessionUserId = newUserId;
                return;
            }
        }

        _lastSessionUserId = newUserId;
        var allowed = _session?.Has(AppPermission.ViewRecords) == true;
        _canEdit = _session?.Has(AppPermission.EditRecords) == true;
        _canDelete = _session?.Has(AppPermission.DeleteRecords) == true;
        _canClearAll = _session?.Has(AppPermission.ClearAllRecords) == true;
        _canCorrect = _session?.Has(AppPermission.ApplyCorrectiveAction) == true;
        _canManageReports = _session?.Has(AppPermission.ManageReports) == true;
        if (!allowed || _session is null)
        {
            _allowed = false;
            if (!_canEdit)
            {
                _editTarget = null;
            }

            if (!_canCorrect)
            {
                _correctiveTarget = null;
            }

            return;
        }

        _allowed = true;
        if (_recordsReady)
        {
            return;
        }

        Nav.LocationChanged += OnLocationChanged;
        ApplyQueryFilters();
        _totalInDb = await RecordService.CountAllAsync();
        await LoadAsync();
        _recordsReady = true;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        if (!_allowed)
        {
            return;
        }

        var path = Nav.ToBaseRelativePath(e.Location).Split('?', '#')[0];
        if (!path.Equals("registros", StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        _ = InvokeAsync(async () =>
        {
            ApplyQueryFilters();
            await LoadAsync();
        });
    }

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;

    /// <summary>Permite abrir Registros desde Informes con ?from=&amp;to=&amp;telar=&amp;tela=.</summary>
    private void ApplyQueryFilters()
    {
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);
        var applied = false;

        // Sin query: no tocar filtros (usuario puede haberlos editado a mano).
        if (query.Count == 0)
        {
            return;
        }

        if (query.TryGetValue("from", out var fromRaw) &&
            query.TryGetValue("to", out var toRaw) &&
            ReportDateRange.TryParseQuery(fromRaw.ToString(), toRaw.ToString(), out var range, out _))
        {
            _filterFrom = range.FromUtc.ToLocalTime().Date;
            _filterTo = range.ToInclusiveUtc.ToLocalTime().Date;
            _openedFromInforme = true;
            applied = true;
        }

        if (query.TryGetValue("reportId", out var reportRaw) &&
            Guid.TryParse(reportRaw.ToString(), out var reportId))
        {
            _openedReportId = reportId;
            _openedFromInforme = true;
            _preferSnapshot = true;
            applied = true;
        }
        else if (!query.ContainsKey("reportId") && query.Count > 0)
        {
            _openedReportId = null;
            _openedReportName = null;
            _preferSnapshot = false;
        }

        if (query.TryGetValue("saved", out var savedRaw) &&
            int.TryParse(savedRaw.ToString(), out var savedCount))
        {
            _informeSavedCount = savedCount;
            _openedFromInforme = true;
        }

        if (query.TryGetValue("telar", out var telarRaw) && !string.IsNullOrWhiteSpace(telarRaw))
        {
            _filterTelar = telarRaw.ToString();
            applied = true;
        }
        else if (query.ContainsKey("telar"))
        {
            _filterTelar = "";
        }

        if (query.TryGetValue("tela", out var telaRaw) && !string.IsNullOrWhiteSpace(telaRaw))
        {
            _filterTela = telaRaw.ToString();
            applied = true;
        }
        else if (query.ContainsKey("tela"))
        {
            _filterTela = "";
        }

        if (applied && _filterFrom is not null && _filterTo is not null)
        {
            _message = _informeSavedCount > 0
                ? $"Abierto desde informe · periodo {_filterFrom:dd/MM/yyyy} – {_filterTo:dd/MM/yyyy} " +
                  $"(el informe recordaba {_informeSavedCount} filas)."
                : $"Abierto desde informe · periodo {_filterFrom:dd/MM/yyyy} – {_filterTo:dd/MM/yyyy}.";
        }
    }

    private async Task ClearDatesAndReloadAsync()
    {
        RecordSelectionRules.ClearOnPageOrFilterChange(_selectedIds);
        _page = 1;
        _filterFrom = null;
        _filterTo = null;
        _openedFromInforme = false;
        _message = "Filtro de fechas quitado. Mostrando mediciones disponibles.";
        _preferSnapshot = false;
        await LoadAsync();
    }

    private async Task ClearAllFiltersAndReloadAsync()
    {
        RecordSelectionRules.ClearOnPageOrFilterChange(_selectedIds);
        _page = 1;
        _filterTelar = "";
        _filterTela = "";
        _filterLote = "";
        _filterTurno = "";
        _filterAlert = "";
        _filterFrom = null;
        _filterTo = null;
        _soloPendientes = false;
        _openedFromInforme = false;
        _informeSavedCount = 0;
        ClearOpenedReportState(clearQuery: false);
        _message = "Filtros limpiados. Mostrando las mediciones disponibles.";
