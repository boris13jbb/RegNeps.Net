@page "/login"
@layout Layout.EmptyLayout
@attribute [AllowAnonymous]
@rendermode InteractiveServer
@inject IHostEnvironment HostEnvironment

<PageTitle>Iniciar sesión — RegNeps</PageTitle>

<div class="rn-login-page">
    <div class="rn-login-card">
        <div class="rn-login-brand">
            <div class="rn-login-brand-mark" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                     stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 3v18h18" />
                    <path d="M18 17V9" />
                    <path d="M13 17V5" />
                    <path d="M8 17v-3" />
                </svg>
            </div>
            <h1>RegNeps VICUNHA</h1>
            <p>Intranet — control de calidad neps</p>
        </div>

        <div class="rn-login-body">
            @if (_showError)
            {
                <div class="alert alert-danger" role="alert">
                    Usuario o contraseña incorrectos, o cuenta inactiva.
                </div>
            }

            <form method="post" action="/api/login">
                <div class="mb-3">
                    <label class="form-label" for="login-username">Usuario</label>
                    <input id="login-username"
                           class="form-control"
                           name="username"
                           autocomplete="username"
                           required
                           autofocus
                           aria-required="true" />
                </div>
                <div class="mb-3">
                    <label class="form-label" for="login-password">Contraseña</label>
                    <input id="login-password"
                           class="form-control"
                           type="password"
                           name="password"
                           autocomplete="current-password"
                           required
                           aria-required="true" />
                </div>
                <button class="rn-morph-btn rn-morph-btn--primary rn-morph-btn--block" type="submit">
                    <span class="rn-morph-btn__inner">
                        <span class="rn-morph-btn__content">
                            <span class="rn-morph-btn__icon" aria-hidden="true">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M5 12h14" /><path d="m12 5 7 7-7 7" />
                                </svg>
                            </span>
                            <span class="rn-morph-btn__text">Entrar</span>
                        </span>
                    </span>
                </button>
            </form>

            @if (HostEnvironment.IsDevelopment())
            {
                <p class="rn-login-hint mb-0">
                    Desarrollo — usuario seed: <code>admin</code> / <code>Admin123!</code>
                </p>
            }
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }

    private bool _showError;

    protected override void OnInitialized()
    {
        _showError = Error == "1";
    }
}
