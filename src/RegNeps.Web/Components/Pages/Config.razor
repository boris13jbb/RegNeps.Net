@page "/config"
@rendermode InteractiveServer
@inject IAlertConfigRepository AlertConfig
@inject CurrentUserService CurrentUser

<PageTitle>Configuración — RegNeps</PageTitle>

@if (!_canView)
{
    <div class="alert alert-warning" role="alert">No tiene permiso para ver la configuración.</div>
}
else
{
    <PageHeader Title="Configuración"
                Subtitle="Umbrales de neps y reglas de seguimiento operativo." />

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="alert alert-danger" role="alert">@_error</div>
    }
    @if (!string.IsNullOrEmpty(_message))
    {
        <div class="alert alert-success" role="status">@_message</div>
    }

    @if (_config is null)
    {
        <LoadingBlock Message="Cargando configuración…" />
    }
    else
    {
        <div class="rn-panel" style="max-width: 560px;">
            <div class="rn-panel-body">
                <fieldset disabled="@(!_canEdit)" class="row g-3">
                    <legend class="visually-hidden">Umbrales y reincidencias</legend>
                    <div class="col-md-6">
                        <label class="form-label" for="cfg-normal">Límite normal máx.</label>
                        <InputNumber id="cfg-normal" class="form-control" @bind-Value="_config.LimiteNormalMax" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="cfg-advertencia">Límite advertencia máx.</label>
                        <InputNumber id="cfg-advertencia" class="form-control" @bind-Value="_config.LimiteAdvertenciaMax" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="cfg-reincidencias">Reincidencias críticas</label>
                        <InputNumber id="cfg-reincidencias" class="form-control" @bind-Value="_config.CantidadReincidenciasCriticas" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="cfg-dias">Días para reincidencia</label>
                        <InputNumber id="cfg-dias" class="form-control" @bind-Value="_config.DiasParaReincidencia" />
                    </div>
                    <div class="col-12">
                        <div class="form-check">
                            <InputCheckbox class="form-check-input" @bind-Value="_config.AlertasActivas" id="alertas" />
                            <label class="form-check-label" for="alertas">Alertas activas</label>
                        </div>
                    </div>
                    <div class="col-12">
                        <p class="small text-muted mb-0">
                            Crítico desde: @_config.LimiteCriticoMin · Ventana reincidencias: @_config.VentanaReincidenciasHoras h
                        </p>
                    </div>
                    @if (_canEdit)
                    {
                        <div class="col-12">
                            <button class="btn btn-primary" @onclick="SaveAsync" disabled="@_saving" aria-busy="@_saving">
                                @(_saving ? "Guardando…" : "Guardar")
                            </button>
                        </div>
                    }
                    else
                    {
                        <div class="col-12">
                            <div class="alert alert-info mb-0" role="status">
                                Solo lectura. Se requiere permiso EditAlertConfig para guardar.
                            </div>
                        </div>
                    }
                </fieldset>
            </div>
        </div>

        @if (_canMigrate)
        {
            <div class="rn-panel mt-3" style="max-width: 560px;">
                <div class="rn-panel-body">
                    <h2 class="h6 mb-2">Datos históricos</h2>
                    <p class="small text-muted mb-3">
                        La importación desde Firestore está en una sola pantalla, fuera del menú diario.
                    </p>
                    <a class="btn btn-outline-primary btn-sm" href="/migracion">Abrir migración</a>
                </div>
            </div>
        }
    }
}

@code {
    private AlertConfig? _config;
    private bool _canView;
    private bool _canEdit;
    private bool _canMigrate;
    private bool _saving;
    private string? _error;
    private string? _message;

    protected override async Task OnInitializedAsync()
    {
        var session = await CurrentUser.GetAsync();
        _canView = session?.Has(AppPermission.ViewSettings) == true
                   || session?.Has(AppPermission.EditAlertConfig) == true;
        _canEdit = session?.Has(AppPermission.EditAlertConfig) == true;
        _canMigrate = session?.Has(AppPermission.ManageUsers) == true;

        if (_canView)
        {
            _config = await AlertConfig.GetAsync();
        }
    }

    private async Task SaveAsync()
    {
        if (_config is null || !await CurrentUser.HasAsync(AppPermission.EditAlertConfig))
        {
            _error = "No tiene permiso para esta operación.";
            return;
        }

        _error = null;
        _message = null;
        _saving = true;
        try
        {
            if (_config.LimiteNormalMax < 0 || _config.LimiteAdvertenciaMax <= _config.LimiteNormalMax)
            {
                throw new InvalidOperationException("Los límites deben ser coherentes (advertencia > normal ≥ 0).");
            }

            await AlertConfig.SaveAsync(_config);
            _message = "Configuración guardada.";
            _config = await AlertConfig.GetAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }
}
