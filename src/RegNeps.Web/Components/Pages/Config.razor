@page "/config"
@rendermode InteractiveServer
@inject IAlertConfigRepository AlertConfig
@inject CurrentUserService CurrentUser

<PageTitle>Configuración — RegNeps</PageTitle>
<PermissionRefresh OnChanged="RefreshAccessAsync" />

@if (!_canView)
{
    <div class="alert alert-warning" role="alert">No tiene permiso para ver la configuración.</div>
}
else
{
    <PageHeader Title="Configuración"
                Subtitle="Criterios oficiales de calidad NEPS y reglas de notificación." />

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="alert alert-danger" role="alert">@_error</div>
    }
    @if (!string.IsNullOrEmpty(_message))
    {
        <div class="alert alert-success" role="status">@_message</div>
    }

    @if (_config is null)
    {
        <LoadingBlock Message="Cargando configuración…" />
    }
    else
    {
        <div class="rn-panel" style="max-width: 640px;">
            <div class="rn-panel-body">
                <h2 class="h6 mb-2">Criterios oficiales de calidad (fijos)</h2>
                <p class="small text-muted mb-2">
                    La calificación de cada registro se calcula siempre con estos criterios
                    (<code>NepsQualityCriteria</code>). No son editables.
                    Fórmula: NEPS/m² = NEPS / 0.09.
                </p>
                <ul class="small mb-3 ps-3">
                    <li><strong>OK:</strong> Q 0–18 / NEPS/m² ≤ 200</li>
                    <li><strong>Mención:</strong> Q 19–45 / NEPS/m² &gt; 200 y ≤ 500</li>
                    <li><strong>Crítico - Realizar Ajuste:</strong> Q 46–54 / NEPS/m² &gt; 500 y ≤ 600</li>
                    <li><strong>2da Calidad:</strong> Q ≥ 55 / NEPS/m² &gt; 600</li>
                </ul>

                <fieldset disabled="@(!_canEdit)" class="row g-3">
                    <legend class="visually-hidden">Notificaciones y reincidencias</legend>
                    <div class="col-md-6">
                        <label class="form-label" for="cfg-reincidencias">Reincidencias críticas</label>
                        <InputNumber id="cfg-reincidencias" class="form-control" @bind-Value="_config.CantidadReincidenciasCriticas" />
                        <div class="form-text">Cantidad de mediciones críticas (ajuste o 2da calidad) en la ventana para marcar reincidencia.</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="cfg-dias">Días para reincidencia</label>
                        <InputNumber id="cfg-dias" class="form-control" @bind-Value="_config.DiasParaReincidencia" />
                        <div class="form-text">Ventana en días (= @_config.VentanaReincidenciasHoras h informativo).</div>
                    </div>
                    <div class="col-12">
                        <div class="form-check">
                            <InputCheckbox class="form-check-input" @bind-Value="_config.AlertasActivas" id="alertas" />
                            <label class="form-check-label" for="alertas">Alertas activas</label>
                        </div>
                        <div class="form-text">
                            Si está desactivado, no se envían notificaciones automáticas (p. ej. SignalR).
                            La calificación de calidad del registro no cambia.
                        </div>
                    </div>
                    @if (_canEdit)
                    {
                        <div class="col-12">
                            <button class="btn btn-primary" @onclick="SaveAsync" disabled="@_saving" aria-busy="@_saving">
                                @(_saving ? "Guardando…" : "Guardar")
                            </button>
                        </div>
                    }
                    else
                    {
                        <div class="col-12">
                            <div class="alert alert-info mb-0" role="status">
                                Solo lectura. Se requiere permiso EditAlertConfig para guardar.
                            </div>
                        </div>
                    }
                </fieldset>
            </div>
        </div>

        @if (_canMigrate)
        {
            <div class="rn-panel mt-3" style="max-width: 640px;">
                <div class="rn-panel-body">
                    <h2 class="h6 mb-2">Datos históricos</h2>
                    <p class="small text-muted mb-3">
                        La importación desde Firestore está en una sola pantalla, fuera del menú diario.
                    </p>
                    <a class="btn btn-outline-primary btn-sm" href="/migracion">Abrir migración</a>
                </div>
            </div>
        }
    }
}

@code {
    private AlertConfig? _config;
    private bool _canView;
    private bool _canEdit;
    private bool _canMigrate;
    private bool _saving;
    private string? _error;
    private string? _message;

    private bool _configReady;

    protected override async Task OnInitializedAsync() => await RefreshAccessAsync();

    private async Task RefreshAccessAsync()
    {
        var session = await CurrentUser.GetAsync();
        _canView = session?.Has(AppPermission.ViewSettings) == true
                   || session?.Has(AppPermission.EditAlertConfig) == true;
        _canEdit = session?.Has(AppPermission.EditAlertConfig) == true;
        _canMigrate = session?.Has(AppPermission.ManageUsers) == true;
        if (!_canView)
        {
            return;
        }

        if (!_configReady || _config is null)
        {
            _config = await AlertConfig.GetAsync();
            _configReady = true;
        }
    }

    private async Task SaveAsync()
    {
        if (_config is null || !await CurrentUser.HasAsync(AppPermission.EditAlertConfig))
        {
            _error = "No tiene permiso para esta operación.";
            return;
        }

        _error = null;
        _message = null;
        _saving = true;
        try
        {
            if (_config.CantidadReincidenciasCriticas < 1)
            {
                throw new InvalidOperationException("Las reincidencias críticas deben ser al menos 1.");
            }

            if (_config.DiasParaReincidencia < 1)
            {
                throw new InvalidOperationException("Los días para reincidencia deben ser al menos 1.");
            }

            await AlertConfig.SaveAsync(_config);
            _message = "Configuración guardada.";
            _config = await AlertConfig.GetAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }
}
