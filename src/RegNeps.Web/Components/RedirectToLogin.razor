@inject NavigationManager Nav

<p class="rn-loading" role="status" aria-live="polite">
    <span class="rn-spinner" aria-hidden="true"></span>
    <span>Redirigiendo al inicio de sesión…</span>
</p>

@code {
    protected override void OnInitialized()
    {
        Nav.NavigateTo($"/login?returnUrl={Uri.EscapeDataString(Nav.Uri)}", forceLoad: true);
    }
}
